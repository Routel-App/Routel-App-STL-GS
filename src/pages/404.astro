---
import Base from '../layouts/Base.astro';
import { href, u } from '../i18n/ui';
const lang = Astro.url.pathname.startsWith('/en') ? 'en' : 'ar';
---
<Base lang={lang} title={u('notFoundTitle', lang)}>
  <section class="page-hero nf">
    <div class="container">
      <span class="eyebrow">404</span>
      <h1>{u('notFoundTitle', lang)}</h1>
      <p class="lead">{u('notFoundText', lang)}</p>
      <div class="actions"><a class="btn btn-cream" href={href(lang, '/')}>{u('backHome', lang)}</a></div>
    </div>
  </section>
</Base>
<style>.nf { min-height: 80vh; display: flex; align-items: center; }</style>
