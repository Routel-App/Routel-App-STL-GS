---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import ServiceCard from '../../../components/ServiceCard.astro';
import { getLang, href, langPaths, t, u } from '../../../i18n/ui';
import { services, servicesIntro } from '../../../data/services';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
---
<Base lang={lang} title={u('services', lang)} description={t(servicesIntro, lang)}>
  <PageHero lang={lang} title={u('services', lang)} lead={t(servicesIntro, lang)} crumbs={[{ label: u('services', lang) }]}>
    <a class="btn btn-primary" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
  </PageHero>
  <section class="section">
    <div class="container grid grid-3">
      {services.map((s) => <ServiceCard lang={lang} s={s} />)}
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
