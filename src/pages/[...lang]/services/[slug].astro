---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import FAQList from '../../../components/FAQList.astro';
import Icon from '../../../components/Icon.astro';
import { type Lang, getLang, href, langs, langParam, t, u } from '../../../i18n/ui';
import { services, type Service } from '../../../data/services';
import { faqSchema } from '../../../i18n/schema';

export function getStaticPaths() {
  return langs.flatMap((l: Lang) => services.map((s) => ({ params: { lang: langParam(l), slug: s.slug }, props: { s } })));
}
const { s } = Astro.props as { s: Service };
const lang = getLang(Astro.params.lang);
const quotePath = `/e-services/quote?mode=${s.quoteMode ?? ''}`;
const others = services.filter((o) => o.slug !== s.slug);
const schema = [
  { '@context': 'https://schema.org', '@type': 'Service', name: t(s.title, lang), description: t(s.intro, lang), provider: { '@type': 'Organization', name: 'STL Global Solutions' }, areaServed: 'SA' },
  ...(s.faq.length ? [faqSchema(s.faq, lang)] : []),
];
---
<Base lang={lang} title={t(s.title, lang)} description={t(s.short, lang)} schema={schema}>
  <PageHero lang={lang} title={t(s.title, lang)} lead={t(s.intro, lang)} eyebrow={s.code} crumbs={[{ label: u('services', lang), path: '/services' }, { label: t(s.title, lang) }]}>
    <a class="btn btn-primary" href={href(lang, quotePath)}>{u('quoteForService', lang)}</a>
  </PageHero>

  <section class="section">
    <div class="container layout">
      <div class="stack">
        <div class="reveal">
          <h2>{u('whatWeOffer', lang)}</h2>
          <ul class="check-list offer">{s.offer.map((o) => <li>{t(o, lang)}</li>)}</ul>
        </div>
        {s.benefits.length > 0 && (
          <div class="reveal mt-2">
            <h2>{u('benefits', lang)}</h2>
            <div class="grid grid-3">
              {s.benefits.map((b) => <div class="benefit"><Icon name="check" /><span>{t(b, lang)}</span></div>)}
            </div>
          </div>
        )}
        {s.faq.length > 0 && (
          <div class="reveal mt-2">
            <h2>{u('faqShort', lang)}</h2>
            <FAQList lang={lang} items={s.faq} openFirst />
          </div>
        )}
      </div>
      <aside class="side">
        <div class="side-card quote-card">
          <span class="icon-badge"><Icon name={s.icon} /></span>
          <h3>{u('quoteForService', lang)}</h3>
          <p>{u('readyText', lang)}</p>
          <a class="btn btn-primary btn-block" href={href(lang, quotePath)}>{u('quote', lang)}</a>
        </div>
        <div class="side-card">
          <h3>{u('otherServices', lang)}</h3>
          <ul class="side-links">{others.map((o) => <li><a href={href(lang, `/services/${o.slug}`)}>{t(o.title, lang)}</a></li>)}</ul>
        </div>
      </aside>
    </div>
  </section>
  <CTABand lang={lang} quotePath={quotePath} />
</Base>
<style>
  .layout { display: grid; grid-template-columns: 1fr 340px; gap: clamp(2rem, 4vw, 3.5rem); align-items: start; }
  @media (max-width: 960px) { .layout { grid-template-columns: 1fr; } }
  .offer { font-size: 1.05rem; }
  .benefit { display: flex; gap: .8rem; align-items: flex-start; background: var(--bg-soft); border-radius: var(--radius); padding: 1.2rem; font-weight: 600; color: var(--navy-800); }
  .benefit :global(.icon) { color: var(--teal-500); flex-shrink: 0; }
  .side { position: sticky; top: calc(var(--header-h) + 1rem); display: grid; gap: 1.2rem; }
  .side-card { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; background: #fff; }
  .quote-card { background: var(--navy-800); color: #c9dbd8; border: 0; }
  .quote-card h3 { color: #fff; }
  .quote-card .icon-badge { background: rgba(255,255,255,.08); color: var(--accent); }
  .side-links { list-style: none; padding: 0; margin: 0; display: grid; }
  .side-links a { display: block; padding: .55rem 0; border-bottom: 1px solid var(--line); color: var(--ink); font-size: .93rem; }
  .side-links a:hover { color: var(--coral-ink); }
</style>
