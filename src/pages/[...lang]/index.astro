---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ShipArt from '../../components/ShipArt.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { site, clientLogos, testimonials, accreditationStrip } from '../../config/site';
import { getLang, href, langPaths, t, u } from '../../i18n/ui';
import { eServices } from '../../i18n/nav';
import { services } from '../../data/services';
import { sectors } from '../../data/sectors';
import { articles } from '../../data/blog';
import { heroSlides, aboutShort, guideQuestion, howWeWork, whyShort } from '../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const featured = services.filter((s) => s.featured);
---
<Base lang={lang} title="">
  <!-- 4.2 Hero slider -->
  <section class="hero" aria-roledescription="carousel">
    <div class="container hero-grid">
      <div class="slides" id="slides">
        {heroSlides.map((s, i) => (
          <div class:list={['slide', { active: i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
            <span class="eyebrow">STL Global Solutions</span>
            {i === 0 ? <h1>{t(s.title, lang)}</h1> : <h2 class="h1">{t(s.title, lang)}</h2>}
            <p class="lead">{t(s.text, lang)}</p>
            <div class="actions-row">
              {s.buttons.map((b) => (
                <a class:list={['btn', b.primary ? 'btn-primary' : 'btn-ghost-light']} href={href(lang, b.path)} tabindex={i === 0 ? undefined : -1}>{t(b.label, lang)}</a>
              ))}
            </div>
          </div>
        ))}
        <div class="dots" role="tablist">
          {heroSlides.map((_, i) => <button type="button" class:list={['dot', { active: i === 0 }]} aria-label={`${i + 1}`} data-i={i} />)}
        </div>
      </div>
      <div class="hero-art"><ShipArt /></div>
    </div>
  </section>

  <!-- 4.3 Quick access -->
  <div class="container quick">
    {eServices.map((e) => (
      <a href={href(lang, e.path)} class="quick-card">
        <span class="icon-badge"><Icon name={e.icon} /></span>
        <span>{t(e.label, lang)}</span>
        <Icon name="arrow" class="flip qarrow" size={18} />
      </a>
    ))}
  </div>

  <!-- 4.4 About + 4.5 Stats -->
  <section class="section">
    <div class="container two-col">
      <div class="reveal">
        <span class="eyebrow">{t(aboutShort.eyebrow, lang)}</span>
        <h2>{t(aboutShort.title, lang)}</h2>
        <p class="lead">{t(aboutShort.text, lang)}</p>
        <a class="btn btn-outline" href={href(lang, '/about')}>{u('readMore', lang)}</a>
      </div>
      <div class="stats reveal">
        {site.stats.map((s) => (
          <div class="stat">
            <strong>{s.value}</strong>
            <span>{t(s.label, lang)}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.6 Guiding question -->
  <section class="section section-dark guide">
    <div class="container">
      <SectionHead title={t(guideQuestion.title, lang)} lead={t(guideQuestion.subtitle, lang)} center />
      <div class="guide-grid">
        {guideQuestion.options.map((o) => (
          <a class="guide-opt reveal" href={href(lang, o.path)}>
            <span class="icon-badge"><Icon name={o.icon} /></span>
            <strong>{t(o.label, lang)}</strong>
            <span class="go">{t(o.target, lang)} <Icon name="arrow" class="flip" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.7 Services -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('services', lang)} title={lang === 'ar' ? 'حلول شحن لكل نوع بضاعة' : 'Shipping Solutions for Every Cargo'} />
        <a class="btn btn-outline" href={href(lang, '/services')}>{u('allServices', lang)}</a>
      </div>
      <div class="grid grid-3">
        {featured.map((s) => <ServiceCard lang={lang} s={s} />)}
      </div>
    </div>
  </section>

  <!-- 4.8 How we work -->
  <section class="section section-soft">
    <div class="container">
      <SectionHead eyebrow={lang === 'ar' ? 'كيف نعمل' : 'How we work'} title={lang === 'ar' ? 'أربع خطوات من الطلب حتى التسليم' : 'Four Steps from Request to Delivery'} center />
      <ol class="steps">
        {howWeWork.map((s, i) => (
          <li class="step reveal">
            <span class="num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{t(s.title, lang)}</h3>
            <p>{t(s.text, lang)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4.9 Why STL -->
  <section class="section">
    <div class="container two-col why">
      <div class="reveal">
        <span class="eyebrow">{u('whyStl', lang)}</span>
        <h2>{lang === 'ar' ? 'شريك واحد يتحمل مسؤولية الرحلة كاملة' : 'One Partner Accountable for the Entire Journey'}</h2>
        <a class="link-arrow" href={href(lang, '/why-stl')}>{u('learnMore', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <ul class="why-list">
        {whyShort.map((w) => (
          <li class="reveal"><span class="icon-badge"><Icon name={w.icon} /></span>{t(w.text, lang)}</li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4.10 Sectors -->
  <section class="section section-soft">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('sectors', lang)} title={lang === 'ar' ? 'نفهم متطلبات قطاعك' : 'We Understand Your Industry'} />
        <a class="btn btn-outline" href={href(lang, '/sectors')}>{u('sectors', lang)}</a>
      </div>
      <div class="sector-grid">
        {sectors.map((s) => (
          <a class="sector reveal" href={href(lang, `/sectors/${s.slug}`)}>
            <Icon name={s.icon} size={34} />
            <span>{t(s.title, lang)}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.11 Trust -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow={lang === 'ar' ? 'الثقة' : 'Trust'} title={lang === 'ar' ? 'شركاء يثقون بنا' : 'Partners Who Trust Us'} center />
      <div class="logos">
        {clientLogos.map((c) => (
          <div class="logo-box">{c.logo ? <img src={c.logo} alt={c.name} loading="lazy" /> : <span>{c.name}</span>}</div>
        ))}
      </div>
      <div class="grid grid-3 mt-2">
        {testimonials.map((q) => (
          <figure class="card testimonial reveal">
            <Icon name="quote" size={30} class="qicon" />
            <blockquote>{t(q.quote, lang)}</blockquote>
            <figcaption><strong>{t(q.name, lang)}</strong><span>{t(q.role, lang)} — {t(q.company, lang)}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="marquee" aria-label={u('certs', lang)}>
      <div class="marquee-track">
        {[...accreditationStrip, ...accreditationStrip].map((a, i) => (
          <span aria-hidden={i >= accreditationStrip.length ? 'true' : undefined}><Icon name="shield" size={18} /> {t(a, lang)}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.12 CTA + latest -->
  <section class="section section-soft">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2>{u('readyTitle', lang)}</h2>
          <p>{u('readyText', lang)}</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
          <a class="btn btn-ghost-light" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> {u('whatsapp', lang)}</a>
        </div>
      </div>
      <div class="head-row mt-2">
        <SectionHead eyebrow={u('media', lang)} title={lang === 'ar' ? 'آخر المقالات والأدلة' : 'Latest Articles & Guides'} />
        <a class="btn btn-outline" href={href(lang, '/media/blog')}>{u('blog', lang)}</a>
      </div>
      <div class="grid grid-3">
        {articles.slice(0, 3).map((a) => (
          <a class="card reveal" href={href(lang, `/media/blog/${a.slug}`)}>
            <span class="tag">{a.readMin} {u('minutesRead', lang)}</span>
            <h3 style="margin-top:.8rem">{t(a.title, lang)}</h3>
            <p>{t(a.excerpt, lang)}</p>
            <span class="link-arrow">{u('readMore', lang)} <Icon name="arrow" class="flip" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
  let i = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => {
      s.classList.toggle('active', k === i);
      s.setAttribute('aria-hidden', String(k !== i));
      s.querySelectorAll('a').forEach((a) => (k === i ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
    });
    dots.forEach((d, k) => d.classList.toggle('active', k === i));
  };
  const start = () => {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    timer = window.setInterval(() => show(i + 1), 6500);
  };
  dots.forEach((d) => d.addEventListener('click', () => { clearInterval(timer); show(Number(d.dataset.i)); start(); }));
  document.getElementById('slides')?.addEventListener('mouseenter', () => clearInterval(timer));
  document.getElementById('slides')?.addEventListener('mouseleave', () => { clearInterval(timer); start(); });
  start();
</script>

<style>
  .hero {
    color: #fff; position: relative; overflow: hidden;
    background: radial-gradient(900px 500px at 90% 10%, rgba(45,195,192,.3), transparent 60%), radial-gradient(700px 400px at 0% 100%, rgba(240,138,36,.18), transparent 60%), linear-gradient(140deg, var(--navy-800), var(--navy-900));
    padding-block: clamp(3rem, 7vw, 5.5rem) clamp(5rem, 9vw, 7rem);
  }
  .hero-grid { display: grid; grid-template-columns: 1.05fr 1fr; gap: 2rem; align-items: center; }
  .slides { position: relative; min-height: 360px; }
  .slide { position: absolute; inset: 0; opacity: 0; transform: translateY(14px); transition: opacity .7s, transform .7s; pointer-events: none; }
  .slide.active { opacity: 1; transform: none; pointer-events: auto; position: relative; }
  .slide h1, .slide .h1 { color: #fff; font-size: clamp(2.1rem, 4.6vw, 3.5rem); margin-bottom: 1rem; font-weight: 700; line-height: 1.25; }
  .slide .eyebrow { color: var(--teal-400); }
  .slide .lead { color: #c7d6e7; font-size: 1.15rem; max-width: 560px; margin-bottom: 1.8rem; }
  .dots { display: flex; gap: .5rem; margin-top: 2.2rem; }
  .dot { width: 34px; height: 5px; border-radius: 4px; border: 0; background: rgba(255,255,255,.25); cursor: pointer; padding: 0; transition: background .3s, width .3s; }
  .dot.active { background: var(--accent); width: 54px; }
  @media (max-width: 900px) { .hero-grid { grid-template-columns: 1fr; } .hero-art { max-width: 520px; margin-inline: auto; } .slides { min-height: 0; } }

  .quick { position: relative; z-index: 5; margin-top: -3.2rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
  .quick-card { background: #fff; border-radius: var(--radius); box-shadow: var(--shadow-lg); padding: 1.1rem 1.2rem; display: flex; align-items: center; gap: .9rem; color: var(--navy-800); font-weight: 700; transition: transform .2s; }
  .quick-card:hover { transform: translateY(-4px); color: var(--teal-500); }
  .quick-card .icon-badge { margin: 0; width: 46px; height: 46px; }
  .quick-card :global(.qarrow) { margin-inline-start: auto; opacity: .5; }
  @media (max-width: 900px) { .quick { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .quick { gap: .6rem; } .quick-card { flex-direction: column; text-align: center; padding: 1rem .6rem; font-size: .9rem; gap: .5rem; } .quick-card :global(.qarrow) { display: none; } }

  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1rem; }
  .stat { background: var(--bg-soft); border-radius: var(--radius); padding: 1.4rem; border-inline-start: 4px solid var(--teal-500); }
  .stat strong { display: block; font-size: 2.1rem; color: var(--navy-800); line-height: 1.1; direction: ltr; text-align: start; }
  .stat span { color: var(--muted); font-size: .95rem; }

  .guide-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); }
  .guide-opt { background: rgba(255,255,255,.05); border: 1px solid rgba(255,255,255,.1); border-radius: var(--radius); padding: 1.4rem; color: #fff; display: flex; flex-direction: column; gap: .6rem; transition: all .25s; }
  .guide-opt:hover { background: var(--teal-500); border-color: var(--teal-500); color: #fff; transform: translateY(-4px); }
  .guide-opt:hover .icon-badge { background: rgba(255,255,255,.2); color: #fff; }
  .guide-opt strong { font-size: 1.08rem; line-height: 1.5; }
  .guide-opt .go { margin-top: auto; display: inline-flex; gap: .3rem; align-items: center; font-size: .88rem; color: #a9bbd0; }
  .guide-opt:hover .go { color: #fff; }
  .guide :global(.section-head h2) { color: #fff; }

  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }
  .head-row :global(.section-head) { margin-bottom: 0; }

  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 1.5rem; counter-reset: s; }
  .step { background: #fff; border-radius: var(--radius); padding: 1.8rem 1.5rem; position: relative; border: 1px solid var(--line); }
  .step .num { font-size: 2.6rem; font-weight: 700; color: var(--teal-50); -webkit-text-stroke: 1.5px var(--teal-500); line-height: 1; display: block; margin-bottom: 1rem; }
  .step p { color: var(--muted); margin: 0; }

  .why-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); gap: 1rem; }
  .why-list li { display: flex; align-items: center; gap: .9rem; background: var(--bg-soft); border-radius: var(--radius); padding: 1rem 1.1rem; font-weight: 600; color: var(--navy-800); }
  .why-list .icon-badge { margin: 0; background: #fff; }

  .sector-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 160px), 1fr)); }
  .sector { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem 1rem; text-align: center; display: flex; flex-direction: column; align-items: center; gap: .8rem; color: var(--navy-800); font-weight: 600; transition: all .25s; }
  .sector :global(.icon) { color: var(--teal-500); }
  .sector:hover { background: var(--navy-800); color: #fff; transform: translateY(-4px); }
  .sector:hover :global(.icon) { color: var(--accent); }

  .logos { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1rem; }
  .logo-box { height: 84px; border: 1px dashed var(--line); border-radius: var(--radius-sm); display: grid; place-items: center; color: var(--muted); font-weight: 600; filter: grayscale(1); opacity: .8; }
  .logo-box img { max-height: 48px; width: auto; }
  .testimonial { margin: 0; }
  .testimonial :global(.qicon) { color: var(--accent); margin-bottom: .8rem; }
  .testimonial blockquote { margin: 0 0 1.2rem; font-size: 1.05rem; color: var(--ink); }
  .testimonial figcaption { margin-top: auto; display: grid; }
  .testimonial figcaption span { color: var(--muted); font-size: .9rem; }

  .marquee { margin-top: 3rem; overflow: hidden; border-block: 1px solid var(--line); background: var(--bg-soft); }
  .marquee-track { display: flex; gap: 3rem; width: max-content; padding-block: 1rem; animation: scroll 35s linear infinite; }
  .marquee-track span { display: inline-flex; gap: .5rem; align-items: center; font-weight: 600; color: var(--navy-700); white-space: nowrap; }
  .marquee-track :global(.icon) { color: var(--teal-500); }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @keyframes scroll { to { transform: translateX(-50%); } }
  :global(html[dir='rtl']) .marquee-track { animation-name: scroll-rtl; }
  @keyframes scroll-rtl { to { transform: translateX(50%); } }
</style>
