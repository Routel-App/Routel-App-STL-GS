---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import { site, clientLogos, testimonials, accreditationStrip } from '../../config/site';
import { getLang, href, langPaths, t, u } from '../../i18n/ui';
import { eServices } from '../../i18n/nav';
import { services } from '../../data/services';
import { sectors } from '../../data/sectors';
import { articles } from '../../data/blog';
import { heroSlides, aboutShort, guideQuestion, howWeWork, whyShort } from '../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const ar = lang === 'ar';
const featured = services.filter((s) => s.featured);
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} title="">
  <!-- 4.2 Hero -->
  <section class="hero" aria-roledescription="carousel">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <span class="eyebrow hero-eyebrow">{ar ? 'الشحن البحري والحلول اللوجستية — المملكة العربية السعودية' : 'Ocean Freight & Logistics — Saudi Arabia'}</span>
      <div class="slides" id="slides">
        {heroSlides.map((s, i) => (
          <div class:list={['slide', { active: i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
            {i === 0 ? <h1>{t(s.title, lang)}</h1> : <p class="h1">{t(s.title, lang)}</p>}
            <p class="hero-text">{t(s.text, lang)}</p>
            <div class="actions-row">
              {s.buttons.map((b) => (
                <a class:list={['btn', b.primary ? 'btn-cream' : 'btn-ghost-light']} href={href(lang, b.path)} tabindex={i === 0 ? undefined : -1}>
                  {t(b.label, lang)} {b.primary && <Icon name="arrow" class="flip" />}
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>

      <form class="track-bar" action={href(lang, '/e-services/tracking')} method="get" role="search">
        <Icon name="search" size={18} />
        <label class="visually-hidden" for="hero-ref">{u('track', lang)}</label>
        <input id="hero-ref" name="ref" dir="ltr" autocomplete="off" placeholder={ar ? 'رقم الحاوية أو البوليصة أو الحجز' : 'Container, B/L or booking number'} />
        <button class="btn btn-cream" type="submit">{ar ? 'تتبع' : 'Track'}</button>
      </form>
    </div>

    <div class="container hero-foot">
      <div class="counter" role="tablist">
        {heroSlides.map((_, i) => (
          <button type="button" class:list={['dot', { active: i === 0 }]} data-i={i} aria-label={`${i + 1}`}><span>{pad(i + 1)}</span><i></i></button>
        ))}
      </div>
      <span class="scroll-cue" aria-hidden="true">{ar ? 'مرّر للأسفل' : 'Scroll'}<i></i></span>
    </div>
  </section>

  <!-- 4.3 Quick access -->
  <nav class="quick" aria-label={u('eservices', lang)}>
    <div class="container quick-grid">
      {eServices.map((e, i) => (
        <a href={href(lang, e.path)} class="quick-item">
          <span class="num-label">{pad(i + 1)}</span>
          <span class="q-label">{t(e.label, lang)}</span>
          <Icon name="arrow" class="flip q-arrow" size={18} />
        </a>
      ))}
    </div>
  </nav>

  <!-- 4.4 About + 4.5 Stats -->
  <section class="section">
    <div class="container two-col">
      <div class="reveal">
        <span class="eyebrow">{t(aboutShort.eyebrow, lang)}</span>
        <h2>{t(aboutShort.title, lang)}</h2>
        <p class="lead">{t(aboutShort.text, lang)}</p>
        <a class="link-arrow" href={href(lang, '/about')}>{u('readMore', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <dl class="stats reveal">
        {site.stats.map((s) => (
          <div class="stat"><dt class="ltr">{s.value}</dt><dd>{t(s.label, lang)}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 4.6 Guiding question -->
  <section class="section section-dark guide">
    <div class="container two-col">
      <div class="reveal guide-head">
        <span class="eyebrow">{ar ? 'ابدأ من هنا' : 'Start here'}</span>
        <h2>{t(guideQuestion.title, lang)}</h2>
        <p class="lead">{t(guideQuestion.subtitle, lang)}</p>
      </div>
      <ol class="guide-list">
        {guideQuestion.options.map((o, i) => (
          <li class="reveal">
            <a href={href(lang, o.path)}>
              <span class="num-label">{pad(i + 1)}</span>
              <span class="g-text"><strong>{t(o.label, lang)}</strong><small>{t(o.target, lang)}</small></span>
              <Icon name="arrow" class="flip" size={20} />
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4.7 Services -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('services', lang)} title={ar ? 'حلول شحن لكل نوع بضاعة' : 'Shipping Solutions for Every Cargo'} />
        <a class="btn btn-outline" href={href(lang, '/services')}>{u('allServices', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="grid grid-3 lined">
        {featured.map((s, i) => (
          <a class="card svc reveal" href={href(lang, `/services/${s.slug}`)}>
            <div class="svc-top"><span class="num-label">{pad(i + 1)}{s.code ? ` — ${s.code}` : ''}</span><Icon name={s.icon} class="svc-icon" /></div>
            <h3>{t(s.title, lang).replace(/\s*\([^)]*\)\s*$/, '')}</h3>
            <p>{t(s.short, lang)}</p>
            <span class="link-arrow">{u('learnMore', lang)} <Icon name="arrow" class="flip" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.8 How we work -->
  <section class="section section-soft">
    <div class="container">
      <SectionHead eyebrow={ar ? 'كيف نعمل' : 'How we work'} title={ar ? 'أربع خطوات من الطلب حتى التسليم' : 'Four Steps from Request to Delivery'} />
      <ol class="steps">
        {howWeWork.map((s, i) => (
          <li class="step reveal">
            <span class="step-num">{pad(i + 1)}</span>
            <h3>{t(s.title, lang)}</h3>
            <p>{t(s.text, lang)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4.9 Why STL -->
  <section class="section">
    <div class="container why">
      <div class="why-visual reveal" aria-hidden="true">
        <div class="why-quote">
          <span class="eyebrow">{u('whyStl', lang)}</span>
          <p>{ar ? 'شريك واحد يتحمل مسؤولية الرحلة كاملة.' : 'One partner accountable for the entire journey.'}</p>
        </div>
      </div>
      <div>
        <h2 class="reveal">{ar ? 'لماذا تختار الشركات STL' : 'Why Businesses Choose STL'}</h2>
        <ul class="why-list">
          {whyShort.map((w) => (
            <li class="reveal"><Icon name={w.icon} size={22} />{t(w.text, lang)}</li>
          ))}
        </ul>
        <a class="link-arrow" href={href(lang, '/why-stl')}>{u('learnMore', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
    </div>
  </section>

  <!-- 4.10 Sectors -->
  <section class="section section-soft">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('sectors', lang)} title={ar ? 'نفهم متطلبات قطاعك' : 'We Understand Your Industry'} />
        <a class="btn btn-outline" href={href(lang, '/sectors')}>{u('sectors', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="grid grid-4 lined sectors">
        {sectors.map((s) => (
          <a class="card sector reveal" href={href(lang, `/sectors/${s.slug}`)}>
            <Icon name={s.icon} size={30} />
            <span>{t(s.title, lang)}</span>
          </a>
        ))}
        <a class="card sector sector-cta reveal" href={href(lang, '/e-services/quote')}>
          <Icon name="arrow" class="flip" size={30} />
          <span>{u('quote', lang)}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4.11 Trust -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow={ar ? 'الثقة' : 'Trust'} title={ar ? 'شركاء يثقون بنا' : 'Partners Who Trust Us'} />
      <div class="logos">
        {clientLogos.map((c) => (
          <div class="logo-box">{c.logo ? <img src={c.logo} alt={c.name} loading="lazy" /> : <span>{c.name}</span>}</div>
        ))}
      </div>
      <div class="grid grid-3 lined mt-2">
        {testimonials.map((q) => (
          <figure class="card testimonial reveal">
            <span class="qmark" aria-hidden="true">“</span>
            <blockquote>{t(q.quote, lang)}</blockquote>
            <figcaption><strong>{t(q.name, lang)}</strong><span>{t(q.role, lang)} — {t(q.company, lang)}</span></figcaption>
          </figure>
        ))}
      </div>
    </div>
    <div class="marquee" aria-label={u('certs', lang)}>
      <div class="marquee-track">
        {[...accreditationStrip, ...accreditationStrip].map((a, i) => (
          <span aria-hidden={i >= accreditationStrip.length ? 'true' : undefined}>{t(a, lang)}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.12 CTA + latest -->
  <section class="section section-soft">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <span class="eyebrow">{ar ? 'عرض سعر' : 'Get a quote'}</span>
          <h2>{u('readyTitle', lang)}</h2>
          <p>{u('readyText', lang)}</p>
        </div>
        <div class="actions">
          <a class="btn btn-cream" href={href(lang, '/e-services/quote')}>{u('quote', lang)} <Icon name="arrow" class="flip" /></a>
          <a class="btn btn-ghost-light" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> {u('whatsapp', lang)}</a>
        </div>
      </div>
      <div class="head-row mt-2 pt">
        <SectionHead eyebrow={u('media', lang)} title={ar ? 'آخر المقالات والأدلة' : 'Latest Articles & Guides'} />
        <a class="btn btn-outline" href={href(lang, '/media/blog')}>{u('blog', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="grid grid-3 lined">
        {articles.slice(0, 3).map((a) => (
          <a class="card reveal" href={href(lang, `/media/blog/${a.slug}`)}>
            <span class="num-label">{a.readMin} {u('minutesRead', lang)}</span>
            <h3 style="margin-top:1rem">{t(a.title, lang)}</h3>
            <p>{t(a.excerpt, lang)}</p>
            <span class="link-arrow">{u('readMore', lang)} <Icon name="arrow" class="flip" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.dot'));
  const hero = document.querySelector<HTMLElement>('.hero')!;
  let i = 0;
  let timer: number | undefined;
  const DURATION = 7000;
  const show = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => {
      s.classList.toggle('active', k === i);
      s.setAttribute('aria-hidden', String(k !== i));
      s.querySelectorAll('a').forEach((a) => (k === i ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
    });
    dots.forEach((d, k) => { d.classList.remove('active'); void d.offsetWidth; d.classList.toggle('active', k === i); });
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = () => { if (!reduced) timer = window.setInterval(() => show(i + 1), DURATION); };
  hero.style.setProperty('--slide-ms', `${DURATION}ms`);
  dots.forEach((d) => d.addEventListener('click', () => { clearInterval(timer); show(Number(d.dataset.i)); start(); }));
  start();
  requestAnimationFrame(() => hero.classList.add('ready'));
</script>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: 100svh; display: flex; flex-direction: column; justify-content: center; color: var(--cream); overflow: hidden; isolation: isolate; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(4, 39, 38, .84) 0%, rgba(7, 59, 58, .78) 45%, rgba(4, 39, 38, .96) 100%), url('/images/hero-port.jpg') center / cover no-repeat;
    filter: blur(1.2px) saturate(.85); transform: scale(1.08); transition: transform 2.4s var(--ease);
  }
  .hero.ready .hero-bg { transform: scale(1.03); }
  .hero-inner { padding-top: calc(var(--header-h) + 3rem); padding-bottom: 2rem; }
  .hero-eyebrow { color: var(--cream); opacity: .85; }
  .hero-eyebrow::before { background: var(--coral); }
  .slides { display: grid; max-width: 820px; }
  .slide { grid-area: 1 / 1; opacity: 0; transform: translateY(18px); transition: opacity .9s var(--ease), transform .9s var(--ease); pointer-events: none; }
  .slide.active { opacity: 1; transform: none; pointer-events: auto; }
  .slide h1, .slide .h1 { color: var(--cream); font-size: clamp(2.6rem, 6.2vw, 5.2rem); font-weight: 400; line-height: 1.12; margin: 0 0 1.6rem; letter-spacing: -.015em; }
  :global(html[lang='ar']) .slide h1, :global(html[lang='ar']) .slide .h1 { font-weight: 600; line-height: 1.3; letter-spacing: 0; font-size: clamp(2.4rem, 5.6vw, 4.6rem); }
  .hero-text { font-size: 1.15rem; color: rgba(244, 239, 230, .76); max-width: 600px; margin-bottom: 2.4rem; font-weight: 300; }
  :global(html[lang='ar']) .hero-text { font-weight: 400; }

  .track-bar {
    margin-top: clamp(2.5rem, 6vw, 4rem); max-width: 720px; display: flex; align-items: center; gap: .9rem;
    padding: .6rem; padding-inline-start: 1.2rem; background: rgba(244, 239, 230, .08); border: 1px solid rgba(244, 239, 230, .22);
    backdrop-filter: blur(6px);
  }
  .track-bar :global(.icon) { color: rgba(244, 239, 230, .6); flex-shrink: 0; }
  .track-bar input { background: transparent; border: 0; color: var(--cream); padding: .6rem 0; font-size: 1rem; }
  .track-bar input::placeholder { color: rgba(244, 239, 230, .45); }
  html[dir='rtl'] .track-bar input { text-align: right; }
  .track-bar input:focus { box-shadow: none; }

  .hero-foot { display: flex; justify-content: space-between; align-items: center; padding-bottom: 2.2rem; }
  .counter { display: flex; gap: 1.6rem; }
  .dot { background: none; border: 0; padding: 0; cursor: pointer; color: rgba(244, 239, 230, .5); display: grid; gap: .5rem; font: 600 .72rem/1 'Titillium Web', sans-serif; letter-spacing: .18em; text-align: start; }
  .dot i { display: block; width: 64px; height: 1px; background: rgba(244, 239, 230, .25); position: relative; overflow: hidden; }
  .dot i::after { content: ''; position: absolute; inset-block: 0; inset-inline-start: 0; width: 0; background: var(--coral); }
  .dot.active { color: var(--cream); }
  .dot.active i::after { animation: fill var(--slide-ms, 7000ms) linear forwards; }
  @keyframes fill { to { width: 100%; } }
  .scroll-cue { display: inline-flex; align-items: center; gap: .8rem; font-size: .7rem; letter-spacing: .24em; text-transform: uppercase; color: rgba(244, 239, 230, .6); }
  :global(html[lang='ar']) .scroll-cue { letter-spacing: 0; font-size: .85rem; }
  .scroll-cue i { width: 1px; height: 38px; background: linear-gradient(var(--coral), transparent); animation: cue 2s var(--ease) infinite; transform-origin: top; }
  @keyframes cue { 0% { transform: scaleY(0); } 50% { transform: scaleY(1); } 100% { transform: scaleY(1); opacity: 0; } }
  @media (max-width: 640px) { .scroll-cue { display: none; } .track-bar { padding-inline-start: .9rem; } .track-bar .btn { padding-inline: 1.1rem; } }

  /* ---------- quick access ---------- */
  .quick { border-bottom: 1px solid var(--line); background: #fff; }
  .quick-grid { display: grid; grid-template-columns: repeat(4, 1fr); }
  .quick-item { display: flex; align-items: center; gap: 1rem; padding: 1.9rem 1.6rem; color: var(--petrol); border-inline-start: 1px solid var(--line); position: relative; transition: background .3s var(--ease); }
  .quick-item:last-child { border-inline-end: 1px solid var(--line); }
  .quick-item::after { content: ''; position: absolute; bottom: -1px; inset-inline-start: 0; height: 2px; width: 0; background: var(--coral); transition: width .45s var(--ease); }
  .quick-item:hover { background: var(--sand); color: var(--petrol); }
  .quick-item:hover::after { width: 100%; }
  .q-label { font-weight: 600; font-size: 1.02rem; }
  .quick-item :global(.q-arrow) { margin-inline-start: auto; color: var(--coral); }
  @media (max-width: 900px) { .quick-grid { grid-template-columns: 1fr 1fr; } .quick-item { border-bottom: 1px solid var(--line); } }
  @media (max-width: 480px) { .quick-item { padding: 1.2rem .9rem; gap: .6rem; } .q-label { font-size: .92rem; } .quick-item :global(.q-arrow) { display: none; } }

  /* ---------- stats ---------- */
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); margin: 0; border-top: 1px solid var(--line); }
  .stat { padding: 1.8rem 0; border-bottom: 1px solid var(--line); }
  .stat:nth-child(odd) { padding-inline-end: 1.5rem; }
  .stat:nth-child(even) { padding-inline-start: 1.5rem; border-inline-start: 1px solid var(--line); }
  .stat:last-child:nth-child(odd) { grid-column: 1 / -1; border-inline-start: 0; padding-inline-start: 0; }
  .stat dt { font-family: 'Titillium Web', var(--font); font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 300; color: var(--petrol); line-height: 1; margin-bottom: .6rem; }
  .stat dd { margin: 0; color: var(--muted); font-size: .95rem; }

  /* ---------- guide ---------- */
  .guide-head { position: sticky; top: 120px; }
  .guide-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line-dark); }
  .guide-list li { border-bottom: 1px solid var(--line-dark); }
  .guide-list a { display: flex; align-items: center; gap: 1.6rem; padding: 1.6rem .4rem; color: var(--cream); transition: padding .4s var(--ease), background .4s var(--ease); }
  .guide-list a:hover { background: rgba(244, 239, 230, .04); padding-inline-start: 1.2rem; }
  .guide-list .num-label { color: var(--coral); }
  .g-text { flex: 1; display: grid; gap: .2rem; }
  .g-text strong { font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 500; }
  .g-text small { color: rgba(244, 239, 230, .55); font-size: .9rem; }
  .guide-list :global(.icon) { color: var(--coral); transition: transform .4s var(--ease); }
  .guide-list a:hover :global(.icon) { transform: translateX(6px); }
  :global(html[dir='rtl']) .guide-list a:hover :global(.icon) { transform: scaleX(-1) translateX(6px); }
  @media (max-width: 860px) { .guide-head { position: static; } }

  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .head-row :global(.section-head) { margin-bottom: 0; }
  .pt { padding-top: clamp(3rem, 7vw, 6rem); }

  /* ---------- services ---------- */
  .svc-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2.6rem; }
  .svc :global(.svc-icon) { color: var(--coral); stroke-width: 1.3; width: 30px; height: 30px; }
  .svc h3 { font-size: 1.35rem; font-weight: 500; }

  /* ---------- steps ---------- */
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 2.5rem; }
  .step { border-top: 1px solid var(--petrol); padding-top: 1.6rem; }
  .step-num { display: block; font-family: 'Titillium Web', var(--font); font-size: 3.6rem; font-weight: 300; line-height: 1; color: var(--coral); margin-bottom: 1.4rem; }
  .step p { color: var(--muted); margin: 0; }

  /* ---------- why ---------- */
  .why { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2.5rem, 6vw, 6rem); align-items: stretch; }
  @media (max-width: 900px) { .why { grid-template-columns: 1fr; } }
  .why-visual {
    min-height: 460px; position: relative; display: flex; align-items: flex-end; isolation: isolate;
    background: linear-gradient(180deg, rgba(7, 59, 58, .35), rgba(4, 39, 38, .92)), url('/images/page-hero.jpg') center / cover;
  }
  .why-quote { padding: clamp(1.8rem, 4vw, 3rem); }
  .why-quote .eyebrow { color: var(--mint); }
  .why-quote p { color: var(--cream); font-size: clamp(1.5rem, 2.6vw, 2.1rem); line-height: 1.35; margin: 0; font-weight: 400; }
  .why-list { list-style: none; padding: 0; margin: 2rem 0 2.4rem; display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }
  .why-list li { display: flex; gap: .9rem; align-items: center; padding: 1.3rem 0; border-bottom: 1px solid var(--line); font-weight: 600; color: var(--petrol); }
  .why-list li:nth-child(odd) { padding-inline-end: 1rem; }
  .why-list li:nth-child(even) { padding-inline-start: 1rem; border-inline-start: 1px solid var(--line); }
  .why-list :global(.icon) { color: var(--coral); flex-shrink: 0; stroke-width: 1.4; }
  @media (max-width: 520px) { .why-list { grid-template-columns: 1fr; } .why-list li:nth-child(even) { border-inline-start: 0; padding-inline-start: 0; } }

  /* ---------- sectors ---------- */
  .sector { align-items: flex-start; gap: 2.4rem; min-height: 190px; justify-content: space-between; font-weight: 600; font-size: 1.08rem; color: var(--petrol); }
  .sector :global(.icon) { color: var(--coral); stroke-width: 1.3; }
  .sector:hover { background: var(--petrol); color: var(--cream); }
  .sector-cta { background: var(--petrol); color: var(--cream); }
  .sector-cta:hover { background: var(--navy-900); }

  /* ---------- trust ---------- */
  .logos { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); border-top: 1px solid var(--line); border-inline-start: 1px solid var(--line); }
