---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import ServiceArt from '../../components/ServiceArt.astro';
import WorldRoutes from '../../components/WorldRoutes.astro';
import { visiblePorts } from '../../data/network';
import { site, clientLogos, testimonials, accreditationStrip } from '../../config/site';
import { getLang, href, langPaths, t, u } from '../../i18n/ui';
import { eServices } from '../../i18n/nav';
import { categories, categoryBySlug, servicesIn, servicesIntro, serviceHref } from '../../data/services';
import { unitPhoto } from '../../data/photos';
import { sectors } from '../../data/sectors';
import { articles } from '../../data/blog';
import { heroSlides, aboutShort, howWeWork, whyReasons } from '../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const ar = lang === 'ar';
const pad = (n: number) => String(n).padStart(2, '0');
const short = (s: string) => s.replace(/\s*\([^)]*\)\s*$/, '');
const eDesc = [
  ar ? 'برقم الحاوية أو البوليصة' : 'By container or B/L number',
  ar ? 'رد خلال {h} ساعة' : 'Reply within {h} hours',
  ar ? 'مواعيد الرحلات القادمة' : 'Upcoming sailings',
  ar ? 'احسب الحجم واعرف الحاوية' : 'Find the right container',
].map((s) => s.replace('{h}', site.quoteResponseHours));
// one full-bleed photo per hero slide (replace the files to change them)
const slidePhotos = [site.images.hero, '/images/units/projects-heavy-lift.jpg', '/images/units/marine-services.jpg', '/images/units/land-logistics.jpg'];
const marine = [...servicesIn('marine-services'), ...servicesIn('ship-agency')];
---
<Base lang={lang} title="">
  <!-- Hero: full-bleed photo slider -->
  <section class="photo-hero hero" aria-roledescription="carousel">
    <div class="hero-bgs" aria-hidden="true">
      {heroSlides.map((_, i) => <div class:list={['hero-bg', { active: i === 0 }]} style={`background-image: url('${slidePhotos[i % slidePhotos.length]}')`}></div>)}
    </div>
    <div class="container hero-inner">
      <div class="slides">
        {heroSlides.map((s, i) => {
          const [a, b] = t(s.title, lang).split(/\.\.\s*/);
          return (
            <div class:list={['slide', { active: i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
              {i === 0 ? <h1>{b ? <>{a}<br /><em>{b}</em></> : a}</h1> : <p class="h1">{b ? <>{a}<br /><em>{b}</em></> : a}</p>}
              <p class="lead">{t(s.text, lang)}</p>
              <div class="actions-row">
                {s.buttons.map((bt) => <a class:list={['btn', bt.primary ? 'btn-primary' : 'btn-ghost-light']} href={href(lang, bt.path)} tabindex={i === 0 ? undefined : -1}>{t(bt.label, lang)}{bt.primary && <Icon name="arrow" class="flip" />}</a>)}
                {s.buttons.length < 2 && <a class="btn btn-ghost-light" href={href(lang, '/e-services/quote')} tabindex={i === 0 ? undefined : -1}>{u('quote', lang)}</a>}
              </div>
            </div>
          );
        })}
      </div>
      <div class="pager" role="tablist" aria-label={ar ? 'الشرائح' : 'Slides'}>
        {heroSlides.map((_, i) => <button type="button" class:list={['pg', { active: i === 0 }]} data-i={i} aria-label={`${i + 1}`}><span></span></button>)}
      </div>
    </div>

    <form class="track container" action={href(lang, '/e-services/tracking')} method="get" role="search">
      <div class="track-box">
        <label for="hero-ref"><Icon name="search" size={18} />{u('track', lang)}</label>
        <input id="hero-ref" name="ref" dir="ltr" autocomplete="off" placeholder={ar ? 'رقم الحاوية أو البوليصة أو الحجز' : 'Container, B/L or booking no.'} />
        <button class="btn btn-dark" type="submit">{ar ? 'تتبع' : 'Track'}</button>
      </div>
    </form>
  </section>

  <!-- Quick access -->
  <section class="quick" aria-label={u('eservices', lang)}>
    <div class="container quick-grid">
      {eServices.map((e, i) => (
        <a href={href(lang, e.path)} class="q-item">
          <span class="q-ic"><Icon name={e.icon} size={22} /></span>
          <span class="q-text"><strong>{t(e.label, lang)}</strong><small>{eDesc[i]}</small></span>
        </a>
      ))}
    </div>
  </section>

  <!-- Services: sticky stacking cards -->
  <section class="section stack-sec">
    <div class="container stack-grid">
      <aside class="stack-head">
        <span class="eyebrow">{u('services', lang)}</span>
        <h2>{ar ? 'خدماتنا' : 'Our Services'}</h2>
        <p class="lead">{t(servicesIntro, lang)}</p>
        <ol class="stack-index" aria-hidden="true">
          {categories.map((c, i) => <li data-i={i}><span class="ltr">{pad(i + 1)}</span>{t(c.title, lang)}</li>)}
        </ol>
        <a class="btn btn-dark" href={href(lang, '/services')}>{u('allServices', lang)} <Icon name="arrow" class="flip" /></a>
      </aside>
      <div class="stack-cards">
        {categories.map((c, i) => {
          const subs = servicesIn(c.slug);
          return (
            <article class="scard" style={`--i:${i}`} data-i={i}>
              <a class="scard-in" href={href(lang, `/services/${c.slug}`)}>
                <span class="scard-img"><ServiceArt art={c.art} photo={unitPhoto(c)} alt="" /></span>
                <span class="scard-body">
                  <span class="scard-code ltr">STLU {String(100000 + (i + 1) * 101).slice(1)} · {c.code}</span>
                  <strong>{t(c.title, lang)}</strong>
                  <small>{t(c.short, lang)}</small>
                  {subs.length > 1 && <span class="scard-subs">{subs.slice(0, 5).map((x) => <em>{short(t(x.title, lang))}</em>)}{subs.length > 5 && <em>+{subs.length - 5}</em>}</span>}
                  <span class="scard-go">{u('learnMore', lang)} <Icon name="arrow" class="flip" size={16} /></span>
                </span>
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- About + stats -->
  <section class="section">
    <div class="container about">
      <div>
        <span class="eyebrow">{t(aboutShort.eyebrow, lang)}</span>
        <h2>{t(aboutShort.title, lang)}</h2>
        <p class="lead">{t(aboutShort.text, lang)}</p>
        <a class="link-arrow" href={href(lang, '/about')}>{u('readMore', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <dl class="stats">
        {site.stats.map((s) => <div class="stat"><dt class="ltr">{s.value}</dt><dd>{t(s.label, lang)}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- Global network map -->
  <section class="section section-dark netmap">
    <div class="container">
      <div class="net-head">
        <div>
          <span class="eyebrow">{ar ? 'شبكتنا' : 'Our network'}</span>
          <h2>{ar ? 'من موانئ المملكة.. إلى موانئ العالم' : 'From Saudi Ports.. to the World'}</h2>
        </div>
        <p class="lead">{ar ? 'من جدة والدمام نربطك بخطوط الشحن الرئيسية إلى آسيا وأوروبا وأفريقيا والأمريكتين، عبر شبكة من الخطوط الملاحية والوكلاء.' : 'From Jeddah and Dammam we connect you to the main trade lanes to Asia, Europe, Africa and the Americas through a network of carriers and agents.'}</p>
      </div>
      <WorldRoutes lang={lang} />
      <div class="net-foot">
        <span><strong class="ltr">{visiblePorts().length}</strong>{ar ? 'موانئ سعودية نخدمها' : 'Saudi ports served'}</span>
        <span><strong class="ltr">4</strong>{ar ? 'قارات نشحن إليها' : 'Continents served'}</span>
        <a class="btn btn-ghost-light" href={href(lang, '/network')}>{ar ? 'الشبكة والموانئ' : 'Network & ports'} <Icon name="arrow" class="flip" /></a>
      </div>
    </div>
  </section>

  <!-- How we work -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow={ar ? 'كيف نعمل' : 'How we work'} title={ar ? 'من الطلب حتى التسليم' : 'From Request to Delivery'} />
      <ol class="steps">
        {howWeWork.map((s, i) => (
          <li class="reveal"><span class="step-no ltr">{pad(i + 1)}</span><h3>{t(s.title, lang)}</h3><p>{t(s.text, lang)}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Marine services -->
  <section class="marine">
    <div class="marine-bg" aria-hidden="true" style={`background-image: url('${unitPhoto(categoryBySlug('marine-services')!) ?? site.images.hero}')`}></div>
    <div class="container marine-grid">
      <div class="marine-copy">
        <span class="eyebrow">{ar ? 'الخدمات البحرية' : 'Marine Services'}</span>
        <h2>{ar ? 'كل ما تحتاجه السفينة عند الرصيف' : 'Everything the vessel needs at berth'}</h2>
        <p class="lead">{t(categoryBySlug('marine-services')!.intro, lang)}</p>
        <div class="actions-row">
          <a class="btn btn-primary" href={href(lang, '/services/marine-services')}>{ar ? 'الخدمات البحرية' : 'Marine services'} <Icon name="arrow" class="flip" /></a>
          <a class="btn btn-ghost-light" href={href(lang, '/contact')}>{u('contact', lang)}</a>
        </div>
      </div>
      <ul class="marine-list">
        {marine.map((s) => <li><a href={href(lang, serviceHref(s))}><Icon name={s.icon} size={20} />{short(t(s.title, lang))}</a></li>)}
      </ul>
    </div>
  </section>

  <!-- Why STL -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('whyStl', lang)} title={ar ? 'شريك واحد يتحمل مسؤولية الرحلة كاملة' : 'One Partner Accountable for the Whole Journey'} />
        <a class="btn btn-outline" href={href(lang, '/about#why-stl')}>{u('learnMore', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="why-grid">
        {whyReasons.map((r) => (
          <div class="why reveal">
            <span class="icon-badge"><Icon name={r.icon} /></span>
            <h3>{t(r.title, lang)}</h3>
            <p>{t(r.text, lang)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sectors -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('sectors', lang)} title={ar ? 'قطاعات نخدمها' : 'Industries We Serve'} />
        <a class="btn btn-outline" href={href(lang, '/sectors')}>{ar ? 'كل القطاعات' : 'All industries'} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="sector-grid">
        {sectors.map((s) => (
          <a class="sector" href={href(lang, `/sectors/${s.slug}`)}>
            <Icon name={s.icon} size={24} />
            <span><strong>{t(s.title, lang)}</strong><small>{t(s.challenge, lang)}</small></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Trust (shown once client logos / testimonials / accreditations exist) -->
  {(clientLogos.length > 0 || testimonials.length > 0 || accreditationStrip.length > 0) && (
  <section class="section">
    <div class="container">
      <SectionHead eyebrow={ar ? 'الثقة' : 'Trust'} title={ar ? 'شركاء يثقون بنا' : 'Partners Who Trust Us'} />
      {clientLogos.length > 0 && <div class="logos">
        {clientLogos.map((c) => <div class="logo-box">{c.logo ? <img src={c.logo} alt={c.name} loading="lazy" /> : <span>{c.name}</span>}</div>)}
      </div>}
      {testimonials.length > 0 && <div class="grid grid-3 mt-2">
        {testimonials.map((q) => (
          <figure class="card testimonial reveal">
            <Icon name="quote" size={28} class="qicon" />
            <blockquote>{t(q.quote, lang)}</blockquote>
            <figcaption><strong>{t(q.name, lang)}</strong><span>{t(q.role, lang)} — {t(q.company, lang)}</span></figcaption>
          </figure>
        ))}
      </div>}
      {accreditationStrip.length > 0 && <ul class="accred">
        {accreditationStrip.map((a) => <li><Icon name="shield" size={18} />{t(a, lang)}</li>)}
      </ul>}
    </div>
  </section>
  )}

  <!-- Articles -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('media', lang)} title={ar ? 'آخر المقالات والأدلة' : 'Latest Articles & Guides'} />
        <a class="btn btn-outline" href={href(lang, '/media/blog')}>{u('blog', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="grid grid-3">
        {articles.slice(0, 3).map((a) => (
          <a class="card post reveal" href={href(lang, `/media/blog/${a.slug}`)}>
            <span class="num-label">{a.readMin} {u('minutesRead', lang)}</span>
            <h3>{t(a.title, lang)}</h3>
            <p>{t(a.excerpt, lang)}</p>
            <span class="link-arrow">{u('readMore', lang)} <Icon name="arrow" class="flip" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-wrap">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <h2>{u('readyTitle', lang)}</h2>
          <p>{u('readyText', lang)}</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={href(lang, '/e-services/quote')}>{u('quote', lang)} <Icon name="arrow" class="flip" /></a>
          <a class="btn btn-ghost-light" href={href(lang, '/contact')}>{u('contact', lang)}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Services stack: covered cards recede slightly; side index follows the active card
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.scard'));
  const idx = Array.from(document.querySelectorAll<HTMLElement>('.stack-index li'));
  let ticking = false;
  const update = () => {
    ticking = false;
    let active = 0;
    cards.forEach((c, k) => {
      const next = cards[k + 1];
      const top = parseFloat(getComputedStyle(c).top);
      const r = c.getBoundingClientRect();
      if (r.top <= top + 2) active = k;
      let p = 0;
      if (next) {
        const nr = next.getBoundingClientRect();
        p = Math.min(1, Math.max(0, 1 - (nr.top - r.top) / r.height));
      }
      const inner = c.firstElementChild as HTMLElement;
      c.style.transform = p ? `scale(${1 - p * 0.05})` : '';
      inner.style.filter = p ? `brightness(${1 - p * 0.12})` : '';
    });
    idx.forEach((li, k) => li.classList.toggle('on', k === active));
  };
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && cards.length) {
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } }, { passive: true });
    update();
  }

  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const bgs = Array.from(document.querySelectorAll<HTMLElement>('.hero-bg'));
  const pgs = Array.from(document.querySelectorAll<HTMLButtonElement>('.pg'));
  let i = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => {
      s.classList.toggle('active', k === i);
      s.setAttribute('aria-hidden', String(k !== i));
      s.querySelectorAll('a').forEach((a) => (k === i ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1')));
    });
    bgs.forEach((b, k) => b.classList.toggle('active', k === i));
    pgs.forEach((d, k) => d.classList.toggle('active', k === i));
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = () => { if (!reduced) timer = window.setInterval(() => show(i + 1), 7000); };
  pgs.forEach((d) => d.addEventListener('click', () => { clearInterval(timer); show(Number(d.dataset.i)); start(); }));
  start();
</script>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; min-height: max(640px, 100svh); display: flex; flex-direction: column; justify-content: flex-end; color: #fff; background: var(--navy-900); overflow: hidden; }
  .hero-bgs, .hero-bg { position: absolute; inset: 0; }
  .hero-bg { background-size: cover; background-position: center; opacity: 0; transform: scale(1.06); transition: opacity 1.2s var(--ease), transform 8s linear; }
  .hero-bg.active { opacity: 1; transform: scale(1); }
  .hero-bgs::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(4, 39, 38, .55) 0%, rgba(4, 39, 38, .25) 40%, rgba(4, 39, 38, .85) 100%); }
  .hero-bgs::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgba(4, 39, 38, .6), transparent 65%); }
  :global(html[dir='rtl']) .hero-bgs::before { background: linear-gradient(270deg, rgba(4, 39, 38, .6), transparent 65%); }
  .hero-inner { position: relative; z-index: 2; padding-top: calc(var(--header-h) + 3rem); }
  .slides { display: grid; max-width: 760px; }
  .slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(14px); transition: opacity .7s var(--ease), transform .7s var(--ease), visibility .7s; }
  .slide.active { opacity: 1; visibility: visible; transform: none; }
  .slide h1, .slide .h1 { color: #fff; font-size: clamp(2.3rem, 5vw, 4.2rem); font-weight: 600; line-height: 1.15; margin: 0 0 1.1rem; letter-spacing: -.02em; }
  :global(html[lang='ar']) .slide h1, :global(html[lang='ar']) .slide .h1 { line-height: 1.35; letter-spacing: 0; }
  .slide em { font-style: normal; color: var(--coral); }
  .slide .lead { color: rgba(255, 255, 255, .85); font-size: clamp(1.05rem, 1.4vw, 1.2rem); max-width: 600px; margin-bottom: 2rem; }
  .pager { display: flex; gap: .5rem; margin-top: 2.4rem; }
  .pg { width: 44px; height: 20px; padding: 0; background: none; border: 0; cursor: pointer; display: grid; align-items: center; }
  .pg span { display: block; height: 3px; border-radius: 3px; background: rgba(255, 255, 255, .35); transition: background .3s; }
  .pg.active span { background: var(--coral); }
  .track { position: relative; z-index: 2; margin-top: clamp(2rem, 5vh, 3.5rem); margin-bottom: clamp(1.5rem, 4vh, 2.5rem); }
  .track-box { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: .8rem; background: #fff; border-radius: 14px; padding: .55rem; box-shadow: var(--shadow-lg); max-width: 760px; }
  .track-box label { display: inline-flex; align-items: center; gap: .5rem; padding-inline: .8rem; color: var(--petrol); font-weight: 500; font-size: .92rem; white-space: nowrap; }
  .track-box label :global(.icon) { color: var(--coral-ink); }
  .track-box input { border: 0; background: var(--paper); box-shadow: none; }
  .track-box input:focus { box-shadow: 0 0 0 2px rgba(7, 59, 58, .12); }
  @media (max-width: 640px) {
    .track-box { grid-template-columns: minmax(0, 1fr) auto; gap: .5rem; }
    .track-box label { grid-column: 1 / -1; padding: .3rem .4rem 0; }
    .track-box input { min-width: 0; font-size: .9rem; }
    .track-box .btn { padding-inline: 1.1rem; }
  }

  /* ---------- quick access ---------- */
  .quick { border-bottom: 1px solid var(--line); }
  .quick-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .q-item { display: flex; gap: .9rem; align-items: center; padding: 1.4rem 1.2rem; color: var(--ink); border-inline-end: 1px solid var(--line); transition: background .2s; }
  .q-item:first-child { border-inline-start: 1px solid var(--line); }
  .q-item:hover { background: var(--paper); color: var(--ink); }
  .q-ic { width: 44px; height: 44px; border-radius: 10px; display: grid; place-items: center; background: var(--teal-50); color: var(--petrol); flex-shrink: 0; transition: background .2s, color .2s; }
  .q-item:hover .q-ic { background: var(--coral); color: #fff; }
  .q-text strong { display: block; font-weight: 500; color: var(--petrol); font-size: .96rem; }
  .q-text small { display: block; color: var(--muted); font-size: .82rem; }
  @media (max-width: 900px) {
    .quick-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .q-item { border-bottom: 1px solid var(--line); }
    .q-item:nth-child(odd) { border-inline-start: 1px solid var(--line); }
  }
  @media (max-width: 520px) { .q-text small { display: none; } .q-item { padding: 1rem .8rem; gap: .6rem; } }

  /* ---------- heads ---------- */
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .head-row :global(.section-head) { margin-bottom: 0; }
  .quick + .section { border-top: 0; }

  /* ---------- services ---------- */
  .stack-grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.6fr); gap: clamp(2rem, 5vw, 4.5rem); align-items: start; }
  .stack-head { position: sticky; top: calc(var(--header-h) + 2.5rem); }
  .stack-head .lead { margin: .8rem 0 1.6rem; font-size: 1rem; }
  .stack-index { list-style: none; padding: 0; margin: 0 0 2rem; border-top: 1px solid var(--line); }
  .stack-index li { display: flex; gap: .8rem; align-items: baseline; padding: .55rem 0; border-bottom: 1px solid var(--line); color: var(--muted); font-size: .92rem; transition: color .3s, padding .3s; }
  .stack-index li span { font-size: .75rem; font-weight: 600; color: #b8c4c3; letter-spacing: .06em; transition: color .3s; }
  .stack-index li.on { color: var(--petrol); font-weight: 500; padding-inline-start: .4rem; }
  .stack-index li.on span { color: var(--coral-ink); }
  .stack-cards { display: grid; gap: 1.5rem; padding-bottom: 2rem; }
  .scard { position: sticky; top: calc(var(--header-h) + 1.5rem + var(--i) * 12px); transform-origin: center top; will-change: transform; }
  .scard-in { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); min-height: 380px; background: #fff; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; color: var(--ink); box-shadow: 0 -10px 40px -24px rgba(7, 59, 58, .35); transition: border-color .3s, box-shadow .3s; }
  .scard-in:hover { color: var(--ink); border-color: #cfd9d8; box-shadow: 0 -10px 40px -24px rgba(7, 59, 58, .35), var(--shadow); }
  .scard-img { position: relative; display: block; overflow: hidden; }
