---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SectionHead from '../../components/SectionHead.astro';
import HeroScene from '../../components/HeroScene.astro';
import { site, clientLogos, testimonials, accreditationStrip } from '../../config/site';
import { getLang, href, langPaths, t, u } from '../../i18n/ui';
import { eServices } from '../../i18n/nav';
import { categories, categoryBySlug, servicesIn, servicesIntro, serviceBySlug } from '../../data/services';
import ServiceArt from '../../components/ServiceArt.astro';
import { unitPhoto } from '../../data/photos';
import { sectors } from '../../data/sectors';
import { articles } from '../../data/blog';
import { heroSlides, aboutShort, guideQuestion, howWeWork, whyReasons, trackingStages } from '../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const ar = lang === 'ar';
const pad = (n: number) => String(n).padStart(2, '0');
const short = (s: string) => s.replace(/\s*\([^)]*\)\s*$/, '');
const eDesc = [
  ar ? 'برقم الحاوية أو البوليصة' : 'By container or B/L number',
  ar ? 'رد خلال {h} ساعة' : 'Reply within {h} hours',
  ar ? 'مواعيد الرحلات القادمة' : 'Upcoming sailings',
  ar ? 'احسب الحجم واعرف الحاوية' : 'Find the right container',
].map((s) => s.replace('{h}', site.quoteResponseHours));
const guide = guideQuestion.options.map((o) => ({ ...o, svc: serviceBySlug(o.path.split('/').pop()!)! }));
---
<Base lang={lang} title="">
  <!-- 4.2 Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">{ar ? 'شحن بحري · مشاريع ورفع ثقيل · خدمات بحرية' : 'Ocean freight · Projects & heavy lift · Marine services'}</span>
        <div class="slides" id="slides" aria-roledescription="carousel">
          {heroSlides.map((s, i) => {
            const [a, b] = t(s.title, lang).split(/\.\.\s*/);
            return (
              <div class:list={['slide', { active: i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
                {i === 0
                  ? <h1>{b ? <>{a}.. <em>{b}</em></> : a}</h1>
                  : <p class="h1">{b ? <>{a}.. <em>{b}</em></> : a}</p>}
                <p class="lead">{t(s.text, lang)}</p>
              </div>
            );
          })}
        </div>
        <div class="actions-row">
          <a class="btn btn-primary" href={href(lang, '/e-services/quote')}>{u('quote', lang)} <Icon name="arrow" class="flip" /></a>
          <a class="btn btn-outline" href={href(lang, '/services')}>{ar ? 'اكتشف خدماتنا' : 'Explore services'}</a>
        </div>
        <div class="pager" role="tablist" aria-label={ar ? 'الشرائح' : 'Slides'}>
          {heroSlides.map((_, i) => <button type="button" class:list={['pg', { active: i === 0 }]} data-i={i} aria-label={`${i + 1}`}></button>)}
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="frame"><HeroScene /><img class="frame-photo" src={site.images.hero} alt="" loading="eager" fetchpriority="high" decoding="async" onerror="this.remove()" /></div>
        <span class="bar bar-a"></span>
        <span class="bar bar-b"></span>
        <div class="track-card">
          <div class="tc-head">
            <span class="live"><i></i>{ar ? 'تتبع مباشر' : 'Live tracking'}</span>
            <span class="tc-ref ltr">MSCU 000000-0</span>
          </div>
          <div class="tc-route">
            <div><small>{ar ? 'من' : 'From'}</small><strong>{ar ? 'شنغهاي' : 'Shanghai'}</strong></div>
            <div class="tc-line"><i></i><Icon name="ship" size={20} /></div>
            <div class="end"><small>{ar ? 'إلى' : 'To'}</small><strong>{ar ? 'جدة' : 'Jeddah'}</strong></div>
          </div>
          <ol class="tc-steps">
            {trackingStages.slice(0, 6).map((_, i) => <li class:list={{ done: i < 2, now: i === 2 }}></li>)}
          </ol>
          <div class="tc-foot">
            <span>{t(trackingStages[2], lang)}</span>
            <span class="muted">{ar ? 'مثال توضيحي' : 'Illustrative'}</span>
          </div>
        </div>
        <div class="chip"><Icon name="stamp" size={18} />{ar ? 'تخليص جمركي وسابر' : 'Customs & SABER'}</div>
      </div>
    </div>

    <form class="container track-strip" action={href(lang, '/e-services/tracking')} method="get" role="search">
      <label for="hero-ref">{u('track', lang)}</label>
      <div class="ts-field">
        <Icon name="search" size={18} />
        <input id="hero-ref" name="ref" dir="ltr" autocomplete="off" placeholder={ar ? 'رقم الحاوية أو البوليصة أو الحجز' : 'Container, B/L or booking no.'} />
      </div>
      <button class="btn btn-dark" type="submit">{ar ? 'تتبع' : 'Track'} <Icon name="arrow" class="flip" /></button>
    </form>
  </section>

  <!-- 4.3 Quick access -->
  <section class="quick" aria-label={u('eservices', lang)}>
    <div class="container quick-grid">
      {eServices.map((e, i) => (
        <a href={href(lang, e.path)} class="q-item">
          <Icon name={e.icon} size={26} />
          <span class="q-text"><strong>{t(e.label, lang)}</strong><small>{eDesc[i]}</small></span>
          <Icon name="arrow" class="flip q-go" size={18} />
        </a>
      ))}
    </div>
  </section>

  <!-- 4.4 About + 4.5 Stats -->
  <section class="section">
    <div class="container">
      <div class="about">
        <span class="eyebrow">{t(aboutShort.eyebrow, lang)}</span>
        <h2 class="reveal">{t(aboutShort.title, lang)}</h2>
        <div class="about-body reveal">
          <p class="lead">{t(aboutShort.text, lang)}</p>
          <a class="link-arrow" href={href(lang, '/about')}>{u('readMore', lang)} <Icon name="arrow" class="flip" /></a>
        </div>
      </div>
      <dl class="stats reveal">
        {site.stats.map((s) => (
          <div class="stat"><dt class="ltr">{s.value}</dt><dd>{t(s.label, lang)}</dd></div>
        ))}
      </dl>
    </div>
  </section>

  <!-- 4.6 Guiding question (interactive) -->
  <section class="section section-white">
    <div class="container">
      <SectionHead eyebrow={ar ? 'ابدأ من هنا' : 'Start here'} title={t(guideQuestion.title, lang)} lead={t(guideQuestion.subtitle, lang)} />
      <div class="guide" id="guide">
        <div class="g-options" role="tablist" aria-orientation="vertical">
          {guide.map((o, i) => (
            <button type="button" role="tab" id={`g-tab-${i}`} aria-controls={`g-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} class="g-opt" data-i={i}>
              <span class="num-label">{pad(i + 1)}</span>
              <span>{t(o.label, lang)}</span>
              <Icon name="arrow" class="flip" size={18} />
            </button>
          ))}
        </div>
        <div class="g-panels on-dark">
          {guide.map((o, i) => (
            <div class="g-panel" role="tabpanel" id={`g-panel-${i}`} aria-labelledby={`g-tab-${i}`} hidden={i !== 0}>
              <Icon name={o.svc.icon} size={40} class="g-icon" />
              <span class="eyebrow">{t(o.target, lang)}</span>
              <h3>{short(t(o.svc.title, lang))}</h3>
              <p>{t(o.svc.intro, lang)}</p>
              <ul class="check-list">{o.svc.offer.slice(0, 3).map((x) => <li>{t(x, lang)}</li>)}</ul>
              <div class="actions-row">
                <a class="btn btn-primary" href={href(lang, `/e-services/quote?mode=${o.svc.quoteMode ?? ''}`)}>{u('quote', lang)}</a>
                <a class="link-arrow" href={href(lang, o.path)}>{u('learnMore', lang)} <Icon name="arrow" class="flip" /></a>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 4.7 Services: six business units -->
  <section class="section">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('services', lang)} title={ar ? 'ست وحدات أعمال.. وجهة واحدة' : 'Six Business Units.. One Partner'} lead={t(servicesIntro, lang)} />
        <a class="btn btn-outline" href={href(lang, '/services')}>{u('allServices', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="units">
        {categories.map((c, i) => (
          <article class="unit reveal">
            <a class="unit-art" href={href(lang, `/services/${c.slug}`)} tabindex="-1" aria-hidden="true">
              <ServiceArt art={c.art} photo={unitPhoto(c)} />
              <span class="unit-code ltr">{pad(i + 1)} / {c.code}</span>
            </a>
            <div class="unit-body">
              <h3><a href={href(lang, `/services/${c.slug}`)}>{t(c.title, lang)}</a></h3>
              <p>{t(c.short, lang)}</p>
              <ul class="unit-list">
                {servicesIn(c.slug).map((s) => <li><a href={href(lang, `/services/${s.slug}`)}>{short(t(s.title, lang))}</a></li>)}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.7b Marine services spotlight -->
  <section class="section section-dark marine">
    <div class="container marine-grid">
      <div class="marine-copy">
        <span class="eyebrow">{ar ? 'جديد: الخدمات البحرية' : 'New: Marine Services'}</span>
        <h2>{ar ? <>كل ما تحتاجه <em>السفينة</em> عند الرصيف</> : <>Everything the <em>vessel</em> needs at berth</>}</h2>
        <p class="lead">{t(categoryBySlug('marine')!.intro, lang)}</p>
        <div class="actions-row">
          <a class="btn btn-primary" href={href(lang, '/services/marine')}>{ar ? 'اكتشف الخدمات البحرية' : 'Explore marine services'} <Icon name="arrow" class="flip" /></a>
          <a class="btn btn-ghost-light" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> {ar ? 'طلب عاجل 24/7' : 'Urgent request 24/7'}</a>
        </div>
      </div>
      <ul class="marine-list">
        {servicesIn('marine').map((s) => (
          <li class="reveal">
            <a href={href(lang, `/services/${s.slug}`)}>
              <Icon name={s.icon} size={26} />
              <span><strong>{short(t(s.title, lang))}</strong><small>{t(s.short, lang)}</small></span>
              <Icon name="arrow" class="flip go" size={18} />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 4.8 How we work: a route -->
  <section class="section section-dark how">
    <div class="container">
      <SectionHead eyebrow={ar ? 'كيف نعمل' : 'How we work'} title={ar ? 'رحلة واضحة من الطلب حتى التسليم' : 'A Clear Route from Request to Delivery'} />
      <ol class="route">
        {howWeWork.map((s, i) => (
          <li class="stop reveal">
            <span class="pin">{pad(i + 1)}</span>
            <h3>{t(s.title, lang)}</h3>
            <p>{t(s.text, lang)}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 4.9 Why STL -->
  <section class="section">
    <div class="container why">
      <div class="why-head">
        <span class="eyebrow">{u('whyStl', lang)}</span>
        <h2>{ar ? <>شريك <em>واحد</em> يتحمل مسؤولية الرحلة كاملة</> : <>One <em>partner</em> accountable for the entire journey</>}</h2>
        <a class="btn btn-dark" href={href(lang, '/why-stl')}>{u('learnMore', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="why-grid">
        {whyReasons.map((r) => (
          <div class="why-item reveal">
            <Icon name={r.icon} size={26} />
            <h3>{t(r.title, lang)}</h3>
            <p>{t(r.text, lang)}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 4.10 Sectors: horizontal scroller -->
  <section class="section section-white sectors">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('sectors', lang)} title={ar ? 'نفهم متطلبات قطاعك' : 'Built Around Your Industry'} />
        <div class="scroll-btns">
          <button type="button" class="sb" data-dir="-1" aria-label={ar ? 'السابق' : 'Previous'}><Icon name="arrow" size={18} class="back" /></button>
          <button type="button" class="sb" data-dir="1" aria-label={ar ? 'التالي' : 'Next'}><Icon name="arrow" size={18} class="flip" /></button>
        </div>
      </div>
    </div>
    <div class="sector-track" id="sector-track">
      {sectors.map((s, i) => (
        <a class="sector-card" href={href(lang, `/sectors/${s.slug}`)}>
          <span class="num-label">{pad(i + 1)}</span>
          <Icon name={s.icon} size={44} />
          <div>
            <h3>{t(s.title, lang)}</h3>
            <p>{t(s.challenge, lang)}</p>
          </div>
          <span class="link-arrow">{u('learnMore', lang)} <Icon name="arrow" class="flip" /></span>
        </a>
      ))}
    </div>
  </section>

  <!-- 4.11 Trust (shown once client logos / testimonials / accreditations exist) -->
  {(clientLogos.length > 0 || testimonials.length > 0 || accreditationStrip.length > 0) && (
  <section class="section">
    <div class="container">
      <SectionHead eyebrow={ar ? 'الثقة' : 'Trust'} title={ar ? 'شركاء يثقون بنا' : 'Partners Who Trust Us'} />
      {clientLogos.length > 0 && <div class="logos">
        {clientLogos.map((c) => <div class="logo-box">{c.logo ? <img src={c.logo} alt={c.name} loading="lazy" /> : <span>{c.name}</span>}</div>)}
      </div>}
      {testimonials.length > 0 && <div class="grid grid-3 mt-2">
        {testimonials.map((q) => (
          <figure class="card testimonial reveal">
            <Icon name="quote" size={30} class="qicon" />
            <blockquote>{t(q.quote, lang)}</blockquote>
            <figcaption><strong>{t(q.name, lang)}</strong><span>{t(q.role, lang)} — {t(q.company, lang)}</span></figcaption>
          </figure>
        ))}
      </div>}
      {accreditationStrip.length > 0 && <ul class="accred">
        {accreditationStrip.map((a) => <li><Icon name="shield" size={18} />{t(a, lang)}</li>)}
      </ul>}
    </div>
  </section>
  )}

  <!-- 4.12 CTA + latest -->
  <section class="section section-white">
    <div class="container">
      <div class="cta-band reveal">
        <div>
          <span class="eyebrow">{ar ? 'عرض سعر' : 'Get a quote'}</span>
          <h2>{u('readyTitle', lang)}</h2>
          <p>{u('readyText', lang)}</p>
        </div>
        <div class="actions">
          <a class="btn btn-primary" href={href(lang, '/e-services/quote')}>{u('quote', lang)} <Icon name="arrow" class="flip" /></a>
          <a class="btn btn-ghost-light" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> {u('whatsapp', lang)}</a>
        </div>
      </div>
      <div class="head-row mt-2 pt">
        <SectionHead eyebrow={u('media', lang)} title={ar ? 'آخر المقالات والأدلة' : 'Latest Articles & Guides'} />
        <a class="btn btn-outline" href={href(lang, '/media/blog')}>{u('blog', lang)} <Icon name="arrow" class="flip" /></a>
      </div>
      <div class="grid grid-3">
        {articles.slice(0, 3).map((a) => (
          <a class="card post reveal" href={href(lang, `/media/blog/${a.slug}`)}>
            <span class="num-label">{a.readMin} {u('minutesRead', lang)}</span>
            <h3>{t(a.title, lang)}</h3>
            <p>{t(a.excerpt, lang)}</p>
            <span class="link-arrow">{u('readMore', lang)} <Icon name="arrow" class="flip" /></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  // Hero slides
  const slides = Array.from(document.querySelectorAll<HTMLElement>('.slide'));
  const pgs = Array.from(document.querySelectorAll<HTMLButtonElement>('.pg'));
  let i = 0;
  let timer: number | undefined;
  const show = (n: number) => {
    i = (n + slides.length) % slides.length;
    slides.forEach((s, k) => { s.classList.toggle('active', k === i); s.setAttribute('aria-hidden', String(k !== i)); });
    pgs.forEach((d, k) => d.classList.toggle('active', k === i));
  };
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const start = () => { if (!reduced) timer = window.setInterval(() => show(i + 1), 6500); };
  pgs.forEach((d) => d.addEventListener('click', () => { clearInterval(timer); show(Number(d.dataset.i)); start(); }));
  start();

  // Guide tabs
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.g-opt'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('.g-panel'));
  const select = (n: number) => {
    tabs.forEach((tb, k) => tb.setAttribute('aria-selected', String(k === n)));
    panels.forEach((p, k) => (p.hidden = k !== n));
  };
  tabs.forEach((tb, k) => {
    tb.addEventListener('click', () => select(k));
    tb.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
        e.preventDefault();
        const n = (k + (e.key === 'ArrowDown' ? 1 : -1) + tabs.length) % tabs.length;
        tabs[n].focus(); select(n);
      }
    });
  });

  // Sector scroller
  const track = document.getElementById('sector-track')!;
  const rtl = document.documentElement.dir === 'rtl';
  document.querySelectorAll<HTMLButtonElement>('.sb').forEach((b) =>
    b.addEventListener('click', () => {
      const d = Number(b.dataset.dir) * (rtl ? -1 : 1);
      track.scrollBy({ left: d * Math.min(track.clientWidth * 0.8, 420), behavior: 'smooth' });
    }),
  );
</script>

<style>
  /* ---------- hero ---------- */
  .hero { position: relative; padding-top: calc(var(--header-h) + clamp(1.5rem, 4vw, 3rem)); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.05fr .95fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; min-height: min(78vh, 760px); }
  .slides { display: grid; }
  .slide { grid-area: 1 / 1; opacity: 0; transform: translateY(14px); transition: opacity .8s var(--ease), transform .8s var(--ease); pointer-events: none; }
  .slide.active { opacity: 1; transform: none; pointer-events: auto; }
  .slide h1, .slide .h1 { font-size: clamp(2.6rem, 5.6vw, 5rem); font-weight: 600; line-height: 1.08; letter-spacing: -.03em; color: var(--petrol); margin: 0 0 1.4rem; }
  :global(html[lang='ar']) .slide h1, :global(html[lang='ar']) .slide .h1 { line-height: 1.3; letter-spacing: 0; font-size: clamp(2.4rem, 5vw, 4.4rem); }
  .slide em { font-style: normal; color: var(--coral); }
  .slide .lead { max-width: 540px; margin-bottom: 2.2rem; }
  .pager { display: flex; gap: .5rem; margin-top: 2.6rem; }
  .pg { width: 10px; height: 22px; border: 0; padding: 0; background: rgba(7, 59, 58, .18); transform: skewX(-22deg); cursor: pointer; transition: background .3s, width .4s var(--ease); }
  .pg.active { background: var(--coral); width: 34px; }

  .hero-visual { position: relative; height: clamp(420px, 60vh, 620px); }
  .frame { position: absolute; inset: 0 0 0 8%; clip-path: polygon(22% 0, 100% 0, 78% 100%, 0 100%); }
  :global(html[dir='rtl']) .frame { inset: 0 8% 0 0; }
  .frame-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 60%; filter: saturate(.92) contrast(1.04); animation: drift 24s ease-in-out infinite alternate; }
  .frame::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(7, 59, 58, 0) 45%, rgba(7, 59, 58, .45) 100%); pointer-events: none; }
  @keyframes drift { from { transform: scale(1.06); } to { transform: scale(1.14) translateX(1.5%); } }
  .bar { position: absolute; transform: skewX(-22deg); }
  .bar-a { width: 46px; height: 42%; background: var(--coral); bottom: -4%; inset-inline-end: 4%; }
  .bar-b { width: 14px; height: 30%; background: var(--petrol); bottom: -4%; inset-inline-end: calc(4% + 64px); }
  .track-card {
    position: absolute; bottom: 9%; inset-inline-start: 0; width: min(360px, 82%); background: #fff; padding: 1.3rem 1.4rem;
    box-shadow: var(--shadow-lg); clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
    animation: float 6s ease-in-out infinite;
  }
  :global(html[dir='rtl']) .track-card { clip-path: polygon(18px 0, 100% 0, 100% 100%, 0 100%, 0 18px); }
  @keyframes float { 50% { transform: translateY(-8px); } }
  .tc-head { display: flex; justify-content: space-between; align-items: center; font-size: .82rem; margin-bottom: 1rem; }
  .live { display: inline-flex; align-items: center; gap: .45rem; color: var(--petrol); font-weight: 500; }
  .live i { width: 8px; height: 8px; border-radius: 50%; background: #2fb36d; box-shadow: 0 0 0 0 rgba(47, 179, 109, .5); animation: ping 1.8s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 8px rgba(47, 179, 109, 0); } 100% { box-shadow: 0 0 0 0 rgba(47, 179, 109, 0); } }
  .tc-ref { color: var(--muted); font-feature-settings: 'tnum'; }
  .tc-route { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: .9rem; margin-bottom: 1.1rem; }
  .tc-route small { display: block; color: var(--muted); font-size: .75rem; }
  .tc-route strong { font-weight: 500; color: var(--petrol); font-size: 1.05rem; }
  .tc-route .end { text-align: end; }
  .tc-line { position: relative; height: 22px; }
  .tc-line i { position: absolute; inset-inline: 0; top: 50%; border-top: 2px dashed var(--line); }
  .tc-line::before { content: ''; position: absolute; inset-inline-start: 0; top: calc(50% - 1px); height: 2px; width: 46%; background: var(--coral); }
  .tc-line :global(.icon) { position: absolute; top: 0; inset-inline-start: calc(46% - 10px); color: var(--petrol); background: #fff; }
  :global(html[dir='rtl']) .tc-line :global(.icon) { transform: scaleX(-1); }
  .tc-steps { list-style: none; padding: 0; margin: 0 0 .9rem; display: grid; grid-template-columns: repeat(6, 1fr); gap: 4px; }
  .tc-steps li { height: 5px; background: var(--sand); }
  .tc-steps li.done { background: var(--petrol); }
  .tc-steps li.now { background: var(--coral); }
  .tc-foot { display: flex; justify-content: space-between; font-size: .82rem; color: var(--petrol); }
