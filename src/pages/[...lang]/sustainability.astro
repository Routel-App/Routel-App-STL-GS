---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CTABand from '../../components/CTABand.astro';
import SectionHead from '../../components/SectionHead.astro';
import Icon from '../../components/Icon.astro';
import { csrInitiatives } from '../../config/site';
import { getLang, langPaths, t, u } from '../../i18n/ui';
import { vision2030, sustainability } from '../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
---
<Base lang={lang} title={u('sustainability', lang)} description={t(vision2030.text, lang)}>
  <PageHero lang={lang} title={t(vision2030.title, lang)} eyebrow={lang === 'ar' ? 'شريك في رؤية 2030' : 'A partner in Vision 2030'} crumbs={[{ label: u('sustainability', lang) }]} />
  <section class="section">
    <div class="container two-col">
      <div class="reveal"><p class="lead">{t(vision2030.text, lang)}</p></div>
      <ol class="v-points">{vision2030.points.map((p, i) => <li class="reveal"><span>{i + 1}</span>{t(p, lang)}</li>)}</ol>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <SectionHead eyebrow={lang === 'ar' ? 'الاستدامة البيئية' : 'Environmental sustainability'} title={lang === 'ar' ? 'شحن أكثر مسؤولية تجاه البيئة' : 'More Responsible Shipping'} />
      <div class="grid grid-4">
        {sustainability.map((s) => <div class="card reveal"><span class="icon-badge"><Icon name={s.icon} /></span><h3>{t(s.title, lang)}</h3><p>{t(s.text, lang)}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <SectionHead eyebrow={lang === 'ar' ? 'المسؤولية الاجتماعية' : 'Social responsibility'} title={lang === 'ar' ? 'نستثمر في الكفاءات والمجتمع' : 'Investing in Talent and Community'} />
      <ul class="check-list">{csrInitiatives.map((c) => <li>{t(c, lang)}</li>)}</ul>
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
<style>
  .v-points { list-style: none; padding: 0; margin: 0; display: grid; gap: .8rem; }
  .v-points li { display: flex; gap: 1rem; align-items: center; background: var(--bg-soft); border-radius: var(--radius); padding: 1rem 1.2rem; font-weight: 600; color: var(--navy-800); }
  .v-points span { flex-shrink: 0; width: 36px; height: 36px; border-radius: 50%; display: grid; place-items: center; background: #0c7a4c; color: #fff; }
</style>
