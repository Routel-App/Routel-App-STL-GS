---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNav from '../../../components/SubNav.astro';
import CTABand from '../../../components/CTABand.astro';
import Icon from '../../../components/Icon.astro';
import { site } from '../../../config/site';
import { getLang, langPaths, t, u } from '../../../i18n/ui';
import { aboutTabs } from '../../../i18n/nav';
import { ceoMessage } from '../../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
---
<Base lang={lang} title={u('ceo', lang)}>
  <PageHero lang={lang} title={u('ceo', lang)} crumbs={[{ label: u('about', lang), path: '/about' }, { label: u('ceo', lang) }]} />
  <SubNav lang={lang} items={aboutTabs} />
  <section class="section">
    <div class="container ceo">
      <div class="portrait reveal" aria-hidden="true"><Icon name="user" size={90} /><small>[{lang === 'ar' ? 'صورة الرئيس التنفيذي' : 'CEO photo'}]</small></div>
      <figure class="reveal">
        <Icon name="quote" size={44} class="q" />
        <blockquote>{ceoMessage.map((p) => <p>{t(p, lang)}</p>)}</blockquote>
        <figcaption><strong>{t(site.company.ceoName, lang)}</strong><span>{lang === 'ar' ? 'الرئيس التنفيذي' : 'Chief Executive Officer'}</span></figcaption>
      </figure>
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
<style>
  .ceo { display: grid; grid-template-columns: 300px 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  @media (max-width: 800px) { .ceo { grid-template-columns: 1fr; } .portrait { max-width: 300px; } }
  .portrait { aspect-ratio: 4/5; border-radius: calc(var(--radius) * 1.5); background: linear-gradient(160deg, var(--teal-50), #dfe8f2); display: grid; place-items: center; align-content: center; gap: .5rem; color: var(--navy-600); }
  figure { margin: 0; }
  figure :global(.q) { color: var(--accent); margin-bottom: 1rem; }
  blockquote { margin: 0 0 1.5rem; font-size: 1.25rem; color: var(--navy-800); }
  figcaption { display: grid; border-inline-start: 4px solid var(--teal-500); padding-inline-start: 1rem; }
  figcaption span { color: var(--muted); }
</style>
