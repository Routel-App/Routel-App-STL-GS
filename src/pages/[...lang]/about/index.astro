---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import CTABand from '../../../components/CTABand.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Icon from '../../../components/Icon.astro';
import { site, timeline, leadership, csrInitiatives } from '../../../config/site';
import { getLang, langPaths, t, u } from '../../../i18n/ui';
import { aboutStory, coreMessage, vision, mission, values, whyTitle, whyReasons, comparison, ceoMessage, qhse, vision2030, sustainability } from '../../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
const ar = lang === 'ar';
const gm = leadership[0];
const sections = [
  { id: 'overview', label: u('overview', lang) },
  { id: 'vision', label: u('vision', lang) },
  { id: 'why-stl', label: u('whyStl', lang) },
  { id: 'message', label: u('ceo', lang) },
  { id: 'qhse', label: u('qhse', lang) },
  { id: 'sustainability', label: u('sustainability', lang) },
  { id: 'journey', label: ar ? 'مسيرتنا' : 'Our journey' },
];
---
<Base lang={lang} title={u('about', lang)} description={t(coreMessage, lang)}>
  <PageHero lang={lang} title={t(aboutStory.title, lang)} lead={t(coreMessage, lang)} crumbs={[{ label: u('about', lang) }]}>
    {site.downloads.companyProfile && <a class="btn btn-primary" href={site.downloads.companyProfile} download><Icon name="download" /> {u('companyProfile', lang)}</a>}
  </PageHero>

  <nav class="jump" aria-label={u('about', lang)}>
    <div class="container"><ul>{sections.map((s) => <li><a href={`#${s.id}`}>{s.label}</a></li>)}</ul></div>
  </nav>

  <!-- Overview -->
  <section class="section anchor" id="overview">
    <div class="container two-col">
      <div class="stack reveal">
        <h2>{u('overview', lang)}</h2>
        {aboutStory.paragraphs.map((p) => <p class="lead">{t(p, lang)}</p>)}
      </div>
      <dl class="stats reveal">
        {site.stats.map((s) => <div><dt class="ltr">{s.value}</dt><dd>{t(s.label, lang)}</dd></div>)}
      </dl>
    </div>
  </section>

  <!-- Vision, mission, values -->
  <section class="section anchor" id="vision">
    <div class="container">
      <div class="vm-grid">
        <div class="vm reveal">
          <span class="icon-badge"><Icon name="eye" /></span>
          <h2>{ar ? 'الرؤية' : 'Vision'}</h2>
          <p class="lead">{t(vision, lang)}</p>
        </div>
        <div class="vm vm-dark reveal">
          <span class="icon-badge"><Icon name="flag" /></span>
          <h2>{ar ? 'الرسالة' : 'Mission'}</h2>
          <p class="lead">{t(mission, lang)}</p>
        </div>
      </div>
      <h3 class="sub-title">{ar ? 'القيم التي تقود عملنا' : 'The values that drive us'}</h3>
      <div class="values">
        {values.map((v) => <div class="value reveal"><Icon name={v.icon} size={22} /><div><strong>{t(v.title, lang)}</strong><p>{t(v.text, lang)}</p></div></div>)}
      </div>
    </div>
  </section>

  <!-- Why STL -->
  <section class="section anchor" id="why-stl">
    <div class="container">
      <SectionHead eyebrow={u('whyStl', lang)} title={t(whyTitle, lang)} />
      <div class="why-grid">
        {whyReasons.map((r) => (
          <div class="why reveal"><span class="icon-badge"><Icon name={r.icon} /></span><h3>{t(r.title, lang)}</h3><p>{t(r.text, lang)}</p></div>
        ))}
      </div>
      <div class="table-wrap mt-2 cmp reveal">
        <table>
          <thead><tr><th></th><th class="stl">{ar ? 'مع STL' : 'With STL'}</th><th>{ar ? 'الطريقة التقليدية' : 'Traditional way'}</th></tr></thead>
          <tbody>{comparison.map((c) => <tr><th scope="row">{t(c.row, lang)}</th><td class="stl"><Icon name="check" size={16} /> {t(c.stl, lang)}</td><td>{t(c.trad, lang)}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- General manager's message (leadership) -->
  <section class="section anchor" id="message">
    <div class="container ceo">
      <div class="portrait reveal">
        {gm?.photo ? <img src={gm.photo} alt={t(site.company.ceoName, lang)} loading="lazy" /> : <Icon name="user" size={80} />}
      </div>
      <figure class="reveal">
        <h2>{u('ceo', lang)}</h2>
        <blockquote>{ceoMessage.map((p) => <p>{t(p, lang)}</p>)}</blockquote>
        <figcaption>
          <strong>{t(site.company.ceoName, lang)}</strong>
          <span>{t(site.company.ceoTitle, lang)}</span>
          {gm?.linkedin && <a href={gm.linkedin} target="_blank" rel="noopener" class="link-arrow"><Icon name="linkedin" size={16} /> LinkedIn</a>}
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- QHSE -->
  <section class="section anchor" id="qhse">
    <div class="container">
      <div class="head-row">
        <SectionHead eyebrow={u('qhse', lang)} title={ar ? 'الجودة والصحة والسلامة والبيئة' : 'Quality, Health, Safety & Environment'} lead={t(qhse.intro, lang)} />
        {site.downloads.qhsePolicy && <a class="btn btn-outline" href={site.downloads.qhsePolicy} download><Icon name="download" /> {ar ? 'سياسة QHSE (PDF)' : 'QHSE policy (PDF)'}</a>}
      </div>
      <div class="grid grid-2">
        {qhse.policies.map((p) => (
          <div class="policy reveal"><span class="icon-badge"><Icon name={p.icon} /></span><div><h3>{t(p.title, lang)}</h3><p>{t(p.text, lang)}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Sustainability & Vision 2030 -->
  <section class="section anchor" id="sustainability">
    <div class="container">
      <SectionHead eyebrow={u('sustainability', lang)} title={t(vision2030.title, lang)} lead={t(vision2030.text, lang)} />
      <ol class="v-points">{vision2030.points.map((p, i) => <li class="reveal"><span class="ltr">{String(i + 1).padStart(2, '0')}</span>{t(p, lang)}</li>)}</ol>
      <h3 class="sub-title">{ar ? 'شحن أكثر مسؤولية تجاه البيئة' : 'More responsible shipping'}</h3>
      <div class="grid grid-4">
        {sustainability.map((s) => <div class="why reveal"><span class="icon-badge"><Icon name={s.icon} /></span><h3>{t(s.title, lang)}</h3><p>{t(s.text, lang)}</p></div>)}
      </div>
      {csrInitiatives.length > 0 && <>
        <h3 class="sub-title">{ar ? 'المسؤولية الاجتماعية' : 'Social responsibility'}</h3>
        <ul class="check-list csr">{csrInitiatives.map((c) => <li>{t(c, lang)}</li>)}</ul>
      </>}
    </div>
  </section>

  <!-- Journey -->
  <section class="section anchor" id="journey">
    <div class="container">
      <SectionHead eyebrow={ar ? 'مسيرتنا' : 'Our journey'} title={ar ? 'محطات في رحلة STL' : 'Milestones in the STL Journey'} />
      <ol class="timeline">
        {timeline.map((m) => <li class="reveal"><span class="year ltr">{m.year}</span><p>{t(m.text, lang)}</p></li>)}
      </ol>
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
<style>
  .jump { position: sticky; top: 72px; z-index: 5; background: rgba(255, 255, 255, .96); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); }
  .jump ul { list-style: none; margin: 0; padding: .6rem 0; display: flex; gap: .35rem; overflow-x: auto; scrollbar-width: none; }
  .jump a { display: inline-block; padding: .45rem .95rem; color: var(--petrol); white-space: nowrap; font-size: .88rem; border: 1px solid var(--line); border-radius: 999px; transition: background .2s, color .2s, border-color .2s; }
  .jump a:hover { background: var(--petrol); border-color: var(--petrol); color: #fff; }
  .anchor { scroll-margin-top: 120px; }
  .jump + .section { border-top: 0; }
  .head-row { display: flex; justify-content: space-between; align-items: flex-end; gap: 1.5rem; flex-wrap: wrap; margin-bottom: clamp(2rem, 4vw, 3rem); }
  .head-row :global(.section-head) { margin-bottom: 0; }
  .sub-title { margin: 3rem 0 1.2rem; font-size: 1.25rem; font-weight: 600; color: var(--petrol); }

  .stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin: 0; }
  .stats div { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  .stats dt { font-family: var(--font-display); font-size: clamp(2.4rem, 3.8vw, 3rem); font-weight: 700; color: var(--petrol); line-height: 1; }
  .stats dd { margin: .7rem 0 0; color: var(--muted); font-size: .9rem; line-height: 1.6; }

  .vm-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; }
  .vm { border-radius: 16px; padding: clamp(1.8rem, 4vw, 2.6rem); background: var(--paper); border: 1px solid var(--line); }
  .vm h2 { font-size: 1.6rem; }
  .vm .lead { color: var(--ink); margin: 0; }
  .vm-dark { background: var(--petrol); border-color: var(--petrol); }
  .vm-dark h2 { color: #fff; }
  .vm-dark .lead { color: rgba(255, 255, 255, .8); }
  .vm-dark .icon-badge { background: rgba(255, 255, 255, .1); color: var(--coral); }
  .values { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 1rem; }
  .value { display: flex; gap: .9rem; align-items: flex-start; padding: 1.2rem; border: 1px solid var(--line); border-radius: var(--radius); }
  .value :global(.icon) { color: var(--coral-ink); flex-shrink: 0; margin-top: .2rem; }
  .value strong { color: var(--petrol); font-weight: 600; }
  .value p { margin: .25rem 0 0; color: var(--muted); font-size: .92rem; }
  @media (max-width: 800px) { .vm-grid { grid-template-columns: 1fr; } }

  .why-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  .why { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; }
  .why h3 { margin-bottom: .35rem; }
  .why p { color: var(--muted); font-size: .92rem; margin: 0; }
  @media (max-width: 900px) { .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .why-grid { grid-template-columns: 1fr; } }
  .cmp td.stl { color: var(--petrol); font-weight: 500; }
  .cmp td.stl :global(.icon) { display: inline; color: var(--coral-ink); vertical-align: -3px; }
  .cmp th.stl { color: var(--coral-ink); }

  .ceo { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .portrait { aspect-ratio: 4 / 5; border-radius: 16px; overflow: hidden; background: var(--paper); border: 1px solid var(--line); display: grid; place-items: center; color: var(--mint); }
  .portrait img { width: 100%; height: 100%; object-fit: cover; }
  figure { margin: 0; }
  blockquote { margin: 0 0 1.5rem; font-size: 1.15rem; color: var(--ink); }
  figcaption { display: grid; gap: .1rem; border-inline-start: 3px solid var(--coral); padding-inline-start: 1rem; }
  figcaption strong { color: var(--petrol); }
  figcaption span { color: var(--muted); }
  figcaption .link-arrow { margin-top: .4rem; }
  @media (max-width: 800px) { .ceo { grid-template-columns: 1fr; } .portrait { max-width: 260px; } }

  .policy { display: flex; gap: 1.1rem; align-items: flex-start; border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem; }
  .policy .icon-badge { margin: 0; }
  .policy p { color: var(--muted); margin: 0; font-size: .94rem; }

  .v-points { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 1rem; }
  .v-points li { display: grid; gap: .5rem; border-top: 2px solid var(--line); padding-top: 1rem; color: var(--ink); }
  .v-points li:first-child { border-color: var(--coral); }
  .v-points span { font-size: .8rem; font-weight: 600; color: var(--coral-ink); letter-spacing: .06em; }
  .csr { max-width: 820px; }

  .timeline { list-style: none; padding: 0; margin: 0; max-width: 820px; position: relative; }
  .timeline::before { content: ''; position: absolute; inset-block: .8rem; inset-inline-start: calc(64px + 1.2rem); width: 2px; background: var(--line); }
  .timeline li { display: grid; grid-template-columns: 64px 1fr; gap: 2.4rem; padding-block: .8rem; position: relative; }
  .timeline li::after { content: ''; position: absolute; inset-inline-start: calc(64px + 1.2rem - 5px); top: 1.45rem; width: 12px; height: 12px; background: var(--coral); border-radius: 50%; box-shadow: 0 0 0 4px #fff; }
  .year { font-weight: 600; color: var(--petrol); padding-top: .2rem; }
  .timeline p { border: 1px solid var(--line); border-radius: var(--radius-sm); padding: .85rem 1.1rem; margin: 0; }
</style>
