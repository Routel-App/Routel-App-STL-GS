---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNav from '../../../components/SubNav.astro';
import CTABand from '../../../components/CTABand.astro';
import SectionHead from '../../../components/SectionHead.astro';
import Icon from '../../../components/Icon.astro';
import { getLang, langPaths, t, u } from '../../../i18n/ui';
import { aboutTabs } from '../../../i18n/nav';
import { vision, mission, values } from '../../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
---
<Base lang={lang} title={u('vision', lang)} description={t(vision, lang)}>
  <PageHero lang={lang} title={u('vision', lang)} crumbs={[{ label: u('about', lang), path: '/about' }, { label: u('vision', lang) }]} />
  <SubNav lang={lang} items={aboutTabs} />
  <section class="section">
    <div class="container grid grid-2">
      <div class="vm reveal">
        <span class="icon-badge"><Icon name="eye" /></span>
        <h2>{lang === 'ar' ? 'الرؤية' : 'Vision'}</h2>
        <p class="lead">{t(vision, lang)}</p>
      </div>
      <div class="vm vm-dark reveal">
        <span class="icon-badge"><Icon name="flag" /></span>
        <h2>{lang === 'ar' ? 'الرسالة' : 'Mission'}</h2>
        <p class="lead">{t(mission, lang)}</p>
      </div>
    </div>
  </section>
  <section class="section section-soft">
    <div class="container">
      <SectionHead eyebrow={lang === 'ar' ? 'القيم' : 'Values'} title={lang === 'ar' ? 'القيم التي تقود عملنا' : 'The Values That Drive Us'} center />
      <div class="grid grid-3">
        {values.map((v) => (
          <div class="card reveal"><span class="icon-badge"><Icon name={v.icon} /></span><h3>{t(v.title, lang)}</h3><p>{t(v.text, lang)}</p></div>
        ))}
      </div>
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
<style>
  .vm { border-radius: calc(var(--radius) * 1.4); padding: clamp(1.8rem, 4vw, 3rem); background: var(--teal-50); }
  .vm .lead { color: var(--navy-800); margin: 0; }
  .vm-dark { background: var(--navy-800); }
  .vm-dark h2 { color: #fff; }
  .vm-dark .lead { color: #cfdbea; }
  .vm-dark .icon-badge { background: rgba(255,255,255,.1); color: var(--accent); }
</style>
