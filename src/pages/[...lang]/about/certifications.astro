---
import Base from '../../../layouts/Base.astro';
import PageHero from '../../../components/PageHero.astro';
import SubNav from '../../../components/SubNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { certifications } from '../../../config/site';
import { getLang, langPaths, t, u } from '../../../i18n/ui';
import { aboutTabs } from '../../../i18n/nav';
import { certsNote } from '../../../data/company';

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);
---
<Base lang={lang} title={u('certs', lang)} description={t(certsNote, lang)}>
  <PageHero lang={lang} title={u('certs', lang)} lead={t(certsNote, lang)} crumbs={[{ label: u('about', lang), path: '/about' }, { label: u('certs', lang) }]} />
  <SubNav lang={lang} items={aboutTabs} />
  <section class="section">
    <div class="container">
      <div class="badges">
        {certifications.map((c) => <div class="badge reveal"><strong>{c.badge}</strong><span>{t(c.name, lang)}</span></div>)}
      </div>
      <div class="table-wrap mt-2">
        <table>
          <thead><tr><th>{lang === 'ar' ? 'الشهادة / الترخيص' : 'Certificate / License'}</th><th>{lang === 'ar' ? 'الرقم' : 'Number'}</th><th>{lang === 'ar' ? 'الصلاحية' : 'Valid until'}</th></tr></thead>
          <tbody>{certifications.map((c) => <tr><td>{t(c.name, lang)}</td><td>{c.number}</td><td>{c.validity}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
<style>
  .badges { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); }
  .badge { border: 1px solid var(--line); border-radius: var(--radius); padding: 1.4rem 1rem; text-align: center; display: grid; gap: .4rem; background: linear-gradient(180deg, #fff, var(--bg-soft)); }
  .badge strong { font-size: 1.3rem; color: var(--navy-700); direction: ltr; }
  .badge span { font-size: .88rem; color: var(--muted); }
</style>
