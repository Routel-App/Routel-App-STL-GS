---
import Base from '../../../../layouts/Base.astro';
import PageHero from '../../../../components/PageHero.astro';
import CTABand from '../../../../components/CTABand.astro';
import ServiceCard from '../../../../components/ServiceCard.astro';
import { type Lang, getLang, href, langs, langParam, t, u } from '../../../../i18n/ui';
import { articles, type Article } from '../../../../data/blog';
import { serviceBySlug } from '../../../../data/services';

export function getStaticPaths() {
  return langs.flatMap((l: Lang) => articles.map((a) => ({ params: { lang: langParam(l), slug: a.slug }, props: { a } })));
}
const { a } = Astro.props as { a: Article };
const lang = getLang(Astro.params.lang);
const related = a.related.map(serviceBySlug).filter(Boolean);
const schema = [{ '@context': 'https://schema.org', '@type': 'Article', headline: t(a.title, lang), description: t(a.excerpt, lang), inLanguage: lang, publisher: { '@type': 'Organization', name: 'STL Global Forwarding' } }];
---
<Base lang={lang} title={t(a.title, lang)} description={t(a.excerpt, lang)} schema={schema}>
  <PageHero lang={lang} title={t(a.title, lang)} lead={t(a.excerpt, lang)} crumbs={[{ label: u('media', lang), path: '/media' }, { label: u('blog', lang), path: '/media/blog' }, { label: t(a.title, lang) }]}>
    <span class="tag">{a.date ? `${a.date} · ` : ''}{a.readMin} {u('minutesRead', lang)}</span>
  </PageHero>
  <section class="section">
    <article class="container prose">
      {a.sections.map((s) => (<><h2>{t(s.h, lang)}</h2><p>{t(s.p, lang)}</p></>))}
      <p><a class="link-arrow" href={href(lang, '/media/blog')}>← {u('blog', lang)}</a></p>
    </article>
  </section>
  <section class="section section-soft">
    <div class="container">
      <h2>{u('relatedServices', lang)}</h2>
      <div class="grid grid-3 mt-2">{related.map((s) => <ServiceCard lang={lang} s={s!} />)}</div>
    </div>
  </section>
  <CTABand lang={lang} />
</Base>
