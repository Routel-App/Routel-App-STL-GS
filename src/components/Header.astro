---
import { site } from '../config/site';
import { type Lang, href, switchPath, t, u } from '../i18n/ui';
import { mainNav } from '../i18n/nav';
import { services } from '../data/services';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const other: Lang = ar ? 'en' : 'ar';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (p: string) => (p === '/' ? bare === '/' : bare === p || bare.startsWith(p + '/'));
const nav = mainNav.filter((n) => n.path !== '/');
const svcNav = nav.find((n) => n.path === '/services')!;
const shortTitle = (s: string) => s.replace(/\s*\([^)]*\)\s*$/, '');
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href={href(lang, '/')} class="brand" aria-label="STL Global Forwarding"><Logo variant="color" height={44} /></a>

    <nav class="nav" aria-label={u('menu', lang)}>
      <ul>
        {nav.map((item) => (
          <li class:list={[{ 'has-sub': item.children, mega: item === svcNav }]}>
            <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
              {t(item.label, lang)}{item.children && <Icon name="down" size={14} class="caret" />}
            </a>
            {item === svcNav ? (
              <div class="panel mega-panel">
                <ul class="mega-list">
                  {services.map((s) => (
                    <li><a href={href(lang, `/services/${s.slug}`)}><span class="code">{s.code ?? '—'}</span>{shortTitle(t(s.title, lang))}</a></li>
                  ))}
                </ul>
                <a class="mega-promo" href={href(lang, '/e-services/quote')}>
                  <span class="slash"></span>
                  <strong>{ar ? 'عرض سعر خلال ' : 'A quote within '}{site.quoteResponseHours}{ar ? ' ساعة' : ' hours'}</strong>
                  <span>{ar ? 'أرسل تفاصيل شحنتك ونرجع لك بعرض مفصّل.' : 'Send your shipment details and get an itemised offer.'}</span>
                  <span class="go">{u('quote', lang)} <Icon name="arrow" class="flip" size={16} /></span>
                </a>
              </div>
            ) : item.children && (
              <ul class="panel">{item.children.map((c) => <li><a href={href(lang, c.path)}>{t(c.label, lang)}</a></li>)}</ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={switchPath(path, other)} hreflang={other} lang={other}>{u('langName', lang)}</a>
      <a class="icon-btn" href={href(lang, '/e-services/tracking')} aria-label={u('track', lang)} title={u('track', lang)}><Icon name="search" size={19} /></a>
      <a class="btn btn-primary btn-sm quote-btn" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
      <button class="burger" id="burger" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label={u('menu', lang)}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label={u('menu', lang)}>
    <div class="container">
      <ol class="m-list">
        {mainNav.map((item, i) => (
          <li class:list={[{ 'has-sub': item.children }]}>
            <div class="row">
              <span class="num-label">{String(i + 1).padStart(2, '0')}</span>
              <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>{t(item.label, lang)}</a>
              {item.children && <button class="sub-toggle" type="button" aria-expanded="false" aria-label={t(item.label, lang)}><Icon name="down" size={20} /></button>}
            </div>
            {item.children && <ul class="sub-m">{item.children.map((c) => <li><a href={href(lang, c.path)}>{shortTitle(t(c.label, lang))}</a></li>)}</ul>}
          </li>
        ))}
      </ol>
      <div class="m-actions">
        <a class="btn btn-primary btn-block" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
        <a class="btn btn-outline btn-block" href={href(lang, '/e-services/tracking')}>{u('track', lang)}</a>
        <a class="btn btn-outline btn-block" href={switchPath(path, other)} hreflang={other}>{u('langName', lang)}</a>
      </div>
      <p class="m-contact"><a href={`tel:${site.contact.phone}`} dir="ltr" class="ltr">{site.contact.phoneDisplay}</a> · <a href={`mailto:${site.contact.email}`} dir="ltr" class="ltr">{site.contact.email}</a></p>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const burger = document.getElementById('burger')!;
  burger.addEventListener('click', () => {
    const open = header.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-open', open);
  });
  header.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.closest('li')!.classList.toggle('sub-open');
      b.setAttribute('aria-expanded', String(open));
    }),
  );
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header { position: fixed; inset-inline: 0; top: 0; z-index: 50; transition: background .35s var(--ease), box-shadow .35s var(--ease); }
  .site-header.scrolled, .site-header.menu-open { background: rgba(251, 249, 245, .92); backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--line); }
  .site-header.menu-open { backdrop-filter: none; background: var(--paper); }
  .header-inner { display: flex; align-items: center; gap: 2rem; min-height: var(--header-h); transition: min-height .35s var(--ease); }
  .scrolled .header-inner { min-height: 68px; }
  .brand { flex-shrink: 0; }
  .brand :global(img) { transition: height .35s var(--ease); }
  .scrolled .brand :global(img) { height: 38px !important; }

  .nav { flex: 1; display: flex; justify-content: center; }
  .nav > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: .2rem; }
  .nav > ul > li { position: relative; }
  .nav > ul > li > a { display: inline-flex; align-items: center; gap: .3rem; padding: .55rem .85rem; color: var(--ink); font-size: .95rem; font-weight: 400; white-space: nowrap; position: relative; }
  .nav > ul > li > a::after { content: ''; position: absolute; inset-inline: .85rem; bottom: .2rem; height: 2px; background: var(--coral); transform: scaleX(0); transform-origin: var(--origin, left); transition: transform .35s var(--ease); }
  :global(html[dir='rtl']) .nav > ul > li > a::after { --origin: right; }
  .nav > ul > li > a:hover::after, .nav > ul > li > a[aria-current='page']::after { transform: scaleX(1); }
  .nav > ul > li > a[aria-current='page'] { font-weight: 500; color: var(--petrol); }
  .nav :global(.caret) { color: var(--coral); transition: transform .3s var(--ease); }
  .has-sub:hover > a :global(.caret) { transform: rotate(180deg); }

  .panel {
    position: absolute; top: calc(100% + .6rem); inset-inline-start: 0; min-width: 250px; list-style: none; margin: 0; padding: .6rem;
    background: #fff; box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden; transform: translateY(8px); transition: all .3s var(--ease);
  }
  .panel::before { content: ''; position: absolute; inset-inline: 0; top: -.8rem; height: .8rem; }
  .has-sub:hover .panel, .has-sub:focus-within .panel { opacity: 1; visibility: visible; transform: none; }
  .panel a { display: block; padding: .55rem .9rem; color: var(--ink); font-size: .93rem; line-height: 1.5; }
  .panel a:hover { background: var(--sand); color: var(--petrol); }
  .mega-panel { display: grid; grid-template-columns: 1fr 240px; gap: .6rem; min-width: 900px; inset-inline-start: -16rem; }
  .mega-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; }
  .mega-list a { display: flex; gap: .8rem; align-items: baseline; }
  .code { flex-shrink: 0; width: 4.6rem; font-size: .74rem; font-weight: 500; color: var(--coral-ink); direction: ltr; text-align: start; }
  .mega-promo { background: var(--petrol); color: var(--cream) !important; padding: 1.4rem !important; display: flex !important; flex-direction: column; gap: .6rem; }
  .mega-promo:hover { background: var(--navy-900) !important; }
  .mega-promo strong { font-size: 1.15rem; font-weight: 500; line-height: 1.35; }
  .mega-promo > span:not(.slash):not(.go) { font-size: .88rem; color: rgba(244, 239, 230, .7); }
  .mega-promo .go { margin-top: auto; display: inline-flex; align-items: center; gap: .4rem; color: var(--coral); font-size: .9rem; }

  .actions { display: flex; align-items: center; gap: .9rem; flex-shrink: 0; }
  .lang { font-size: .9rem; font-weight: 500; color: var(--petrol); padding: .4rem .2rem; border-bottom: 1px solid transparent; }
  .lang:hover { border-color: var(--coral); }
  .icon-btn { width: 42px; height: 42px; display: grid; place-items: center; color: var(--petrol); box-shadow: inset 0 0 0 1px rgba(7, 59, 58, .22); transition: background .3s, color .3s; }
  .icon-btn:hover { background: var(--petrol); color: var(--cream); }

  .burger { display: none; width: 46px; height: 46px; background: var(--petrol); border: 0; cursor: pointer; position: relative; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 10px, 100% 100%, 0 100%); }
  :global(html[dir='rtl']) .burger { clip-path: polygon(10px 0, 100% 0, 100% 100%, 0 100%, 0 10px); }
  .burger span { position: absolute; inset-inline-start: 12px; height: 2px; background: var(--cream); transition: transform .3s var(--ease), opacity .3s, width .3s; }
  .burger span:nth-child(1) { top: 15px; width: 22px; } .burger span:nth-child(2) { top: 22px; width: 15px; background: var(--coral); } .burger span:nth-child(3) { top: 29px; width: 22px; }
  .menu-open .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .menu-open .burger span:nth-child(2) { opacity: 0; }
  .menu-open .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mobile-nav { display: none; }

  @media (max-width: 1240px) {
    .nav, .lang { display: none; }
    .actions { margin-inline-start: auto; }
    .burger { display: inline-block; }
    .mobile-nav {
      display: block; position: fixed; inset-inline: 0; bottom: 0; top: 68px; background: var(--paper); overflow-y: auto;
      opacity: 0; visibility: hidden; transition: opacity .3s var(--ease), visibility .3s; padding-block: 1.5rem 3rem;
    }
    .menu-open .mobile-nav { opacity: 1; visibility: visible; }
    .menu-open .header-inner { min-height: 68px; }
    .m-list { list-style: none; padding: 0; margin: 0; }
    .m-list > li { border-bottom: 1px solid var(--line); }
    .row { display: flex; align-items: center; gap: 1rem; }
    .row a { flex: 1; display: block; padding: 1rem 0; color: var(--petrol); font-size: 1.35rem; font-weight: 500; }
    .row a[aria-current='page'] { color: var(--coral-ink); }
    .sub-toggle { background: none; border: 0; color: var(--coral); padding: .8rem; cursor: pointer; transition: transform .3s; }
    .sub-open .sub-toggle { transform: rotate(180deg); }
    .sub-m { display: none; list-style: none; padding: 0 0 1rem; margin: 0; padding-inline-start: 2.6rem; }
    .sub-open .sub-m { display: grid; gap: .1rem; }
    .sub-m a { display: block; padding: .4rem 0; color: var(--muted); }
    .m-actions { display: grid; gap: .6rem; margin-top: 2rem; }
    .m-contact { margin-top: 1.5rem; color: var(--muted); }
    :global(body.nav-open) { overflow: hidden; }
  }
  @media (max-width: 560px) { .quote-btn { display: none; } .icon-btn { width: 46px; height: 46px; } }
</style>
