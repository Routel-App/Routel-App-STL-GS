---
import { site } from '../config/site';
import { type Lang, href, switchPath, t, u } from '../i18n/ui';
import { mainNav, type NavItem } from '../i18n/nav';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (p: string) => (p === '/' ? bare === '/' : bare === p || bare.startsWith(p + '/'));

const byPath = (p: string) => mainNav.find((n) => n.path === p)!;
const track: NavItem = { label: { ar: 'التتبع', en: 'Track' }, path: '/e-services/tracking' };
// Desktop: links split around the centred logo (like the reference layout)
const startNav = [byPath('/services'), byPath('/sectors'), byPath('/network'), track];
const endNav = [byPath('/about'), byPath('/media'), byPath('/contact')];
const mobileNav = [...mainNav, track];
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <nav class="nav nav-start" aria-label={u('menu', lang)}>
      <ul>
        {startNav.map((item) => (
          <li class:list={[{ 'has-sub': item.children, mega: item.children && item.children.length > 9 }]}>
            <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
              {t(item.label, lang)}{item.children && <Icon name="down" size={12} class="caret" />}
            </a>
            {item.children && (
              <ul class="sub">{item.children.map((c) => <li><a href={href(lang, c.path)}>{t(c.label, lang)}</a></li>)}</ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <a href={href(lang, '/')} class="brand" aria-label="STL Global Solutions"><Logo variant="white" height={52} /></a>

    <div class="nav-end-wrap">
      <nav class="nav nav-end" aria-label={u('company', lang)}>
        <ul>
          {endNav.map((item) => (
            <li class:list={[{ 'has-sub': item.children }]}>
              <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
                {t(item.label, lang)}{item.children && <Icon name="down" size={12} class="caret" />}
              </a>
              {item.children && (
                <ul class="sub">{item.children.map((c) => <li><a href={href(lang, c.path)}>{t(c.label, lang)}</a></li>)}</ul>
              )}
            </li>
          ))}
        </ul>
      </nav>
      <a class="lang-box" href={switchPath(path, other)} hreflang={other} lang={other} aria-label={u('langName', lang)}>{u('langShort', lang)}</a>
      <a class="btn btn-cream btn-sm quote-btn" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
      <button class="burger" id="burger" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label={u('menu', lang)}>
        <span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label={u('menu', lang)}>
    <div class="container">
      <ul>
        {mobileNav.map((item) => (
          <li class:list={[{ 'has-sub': item.children }]}>
            <div class="row">
              <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>{t(item.label, lang)}</a>
              {item.children && (
                <button class="sub-toggle" type="button" aria-expanded="false" aria-label={t(item.label, lang)}><Icon name="down" size={18} /></button>
              )}
            </div>
            {item.children && <ul class="sub-m">{item.children.map((c) => <li><a href={href(lang, c.path)}>{t(c.label, lang)}</a></li>)}</ul>}
          </li>
        ))}
      </ul>
      <div class="m-actions">
        <a class="btn btn-cream btn-block" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
        <a class="btn btn-ghost-light btn-block" href={switchPath(path, other)} hreflang={other}>{u('langName', lang)}</a>
      </div>
      <div class="m-contact">
        <a href={`tel:${site.contact.unifiedPhone}`} class="ltr">{site.contact.unifiedPhone}</a>
        <a href={`mailto:${site.contact.emailInfo}`} class="ltr">{site.contact.emailInfo}</a>
      </div>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const burger = document.getElementById('burger')!;
  burger.addEventListener('click', () => {
    const open = header.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-open', open);
  });
  header.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.closest('li')!.classList.toggle('sub-open');
      b.setAttribute('aria-expanded', String(open));
    }),
  );
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 40);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header {
    position: fixed; inset-inline: 0; top: 0; z-index: 50; color: var(--cream);
    transition: background .4s var(--ease), box-shadow .4s var(--ease), padding .4s var(--ease);
    padding-block: 1.1rem;
  }
  .site-header.scrolled, .site-header.menu-open { background: var(--petrol); padding-block: .45rem; box-shadow: 0 1px 0 var(--line-dark); }
  .header-inner { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; min-height: 64px; }
  .brand { justify-self: center; }
  .brand :global(img) { transition: height .4s var(--ease); }
  .scrolled .brand :global(img) { height: 44px !important; }

  .nav ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: clamp(1.1rem, 2.2vw, 2.4rem); }
  .nav > ul > li { position: relative; }
  .nav > ul > li > a {
    display: inline-flex; align-items: center; gap: .35rem; padding-block: .8rem;
    color: var(--cream); font-size: .72rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; white-space: nowrap;
    opacity: .92;
  }
  :global(html[lang='ar']) .nav > ul > li > a { letter-spacing: 0; font-size: .95rem; font-weight: 600; }
  .nav > ul > li > a:hover, .nav > ul > li > a[aria-current='page'] { opacity: 1; color: #fff; }
  .nav > ul > li > a[aria-current='page'] { box-shadow: inset 0 -1px 0 var(--coral); }
  .nav :global(.caret) { opacity: .7; }
  .nav-end-wrap { display: flex; align-items: center; justify-content: flex-end; gap: clamp(1rem, 2vw, 2rem); }

  .sub {
    position: absolute; top: 100%; inset-inline-start: -1.2rem; min-width: 260px; list-style: none; margin: 0; padding: .7rem 0;
    background: #fff; box-shadow: var(--shadow-lg); border-top: 2px solid var(--coral);
    opacity: 0; visibility: hidden; transform: translateY(10px); transition: all .3s var(--ease);
  }
  .mega .sub { display: grid; grid-template-columns: 1fr 1fr; min-width: 600px; }
  .has-sub:hover .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
  .sub a { display: block; padding: .6rem 1.3rem; color: var(--ink); font-size: .93rem; line-height: 1.5; }
  .sub a:hover { background: var(--sand); color: var(--petrol); }

  .lang-box {
    display: inline-grid; place-items: center; min-width: 44px; height: 34px; padding-inline: .6rem;
    border: 1px solid var(--line-dark); color: var(--cream); font-family: 'Cairo', sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: .12em;
  }
  .lang-box:lang(ar) { font-size: 1.05rem; letter-spacing: 0; }
  .lang-box:hover { border-color: var(--cream); color: #fff; }
  .quote-btn { padding: .85rem 1.3rem; }

  .burger { display: none; width: 44px; height: 44px; background: none; border: 1px solid var(--line-dark); cursor: pointer; position: relative; }
  .burger span { position: absolute; inset-inline: 11px; height: 1.5px; background: var(--cream); transition: transform .3s var(--ease), top .3s var(--ease); }
  .burger span:first-child { top: 17px; } .burger span:last-child { top: 25px; }
  .menu-open .burger span:first-child { top: 21px; transform: rotate(45deg); }
  .menu-open .burger span:last-child { top: 21px; transform: rotate(-45deg); }

  .mobile-nav { display: none; }

  @media (max-width: 1200px) {
    .nav, .lang-box { display: none; }
    .burger { display: inline-block; }
    .header-inner { grid-template-columns: auto 1fr; }
    .brand { justify-self: start; }
    .mobile-nav {
      display: block; position: fixed; inset-inline: 0; bottom: 0; top: 76px; background: var(--petrol); overflow-y: auto;
      opacity: 0; visibility: hidden; transform: translateY(-8px); transition: opacity .3s var(--ease), transform .3s var(--ease), visibility .3s;
      padding-block: 1rem 3rem;
    }
    .menu-open .mobile-nav { opacity: 1; visibility: visible; transform: none; }
    .mobile-nav > .container > ul { list-style: none; padding: 0; margin: 0; }
    .mobile-nav li { border-bottom: 1px solid var(--line-dark); }
    .row { display: flex; align-items: center; justify-content: space-between; }
    .row a { flex: 1; display: block; padding: 1.05rem 0; color: var(--cream); font-size: 1.15rem; font-weight: 500; }
    .row a[aria-current='page'] { color: var(--coral); }
    .sub-toggle { background: none; border: 0; color: var(--cream); padding: .8rem; cursor: pointer; transition: transform .3s; }
    .sub-open .sub-toggle { transform: rotate(180deg); }
    .sub-m { display: none; list-style: none; padding: 0 0 1rem; margin: 0; }
    .sub-open .sub-m { display: block; }
    .sub-m li { border: 0; }
    .sub-m a { display: block; padding: .45rem 0; color: rgba(244, 239, 230, .72); font-size: .98rem; }
    .m-actions { display: grid; gap: .7rem; margin-top: 2rem; }
    .m-contact { display: grid; gap: .3rem; margin-top: 2rem; }
    .m-contact a { color: rgba(244, 239, 230, .7); }
    :global(body.nav-open) { overflow: hidden; }
  }
  @media (max-width: 520px) { .quote-btn { display: none; } }
</style>
