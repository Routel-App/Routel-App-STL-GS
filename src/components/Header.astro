---
import { site } from '../config/site';
import { type Lang, href, switchPath, t, u } from '../i18n/ui';
import { mainNav } from '../i18n/nav';
import { categories } from '../data/services';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const ar = lang === 'ar';
const other: Lang = ar ? 'en' : 'ar';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = path.replace(/^\/en(?=\/|$)/, '') || '/';
const isActive = (p: string) => (p === '/' ? bare === '/' : bare === p || bare.startsWith(p + '/'));
const nav = mainNav.filter((n) => n.path !== '/');
const svcNav = nav.find((n) => n.path === '/services')!;
const shortTitle = (s: string) => s.replace(/\s*\([^)]*\)\s*$/, '');
---
<header class="site-header" id="site-header">
  <div class="container header-inner">
    <a href={href(lang, '/')} class="brand" aria-label="STL Global Forwarding"><span class="logo-dark"><Logo variant="color" height={66} /></span><span class="logo-light"><Logo variant="white" height={66} /></span></a>

    <nav class="nav" aria-label={u('menu', lang)}>
      <ul>
        {nav.map((item) => (
          <li class:list={[{ 'has-sub': item.children, mega: item === svcNav }]}>
            <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>
              {t(item.label, lang)}{item.children && <Icon name="down" size={14} class="caret" />}
            </a>
            {item === svcNav ? (
              <div class="panel mega-panel">
                <ul class="mega-cats">
                  {categories.map((c) => (
                    <li><a class="mega-item" href={href(lang, `/services/${c.slug}`)}>
                      <span class="mi-icon"><Icon name={c.icon} size={20} /></span>
                      <span class="mi-text"><strong>{t(c.title, lang)}</strong><small>{t(c.short, lang)}</small></span>
                    </a></li>
                  ))}
                </ul>
                <a class="mega-promo" href={href(lang, '/e-services/quote')}>
                  <span class="slash"></span>
                  <strong>{ar ? 'عرض سعر خلال ' : 'A quote within '}{site.quoteResponseHours}{ar ? ' ساعة' : ' hours'}</strong>
                  <span>{ar ? 'أرسل تفاصيل شحنتك ونرجع لك بعرض مفصّل.' : 'Send your shipment details and get an itemised offer.'}</span>
                  <span class="go">{u('quote', lang)} <Icon name="arrow" class="flip" size={16} /></span>
                </a>
              </div>
            ) : item.children && (
              <ul class="panel">{item.children.map((c) => <li><a href={href(lang, c.path)}>{t(c.label, lang)}</a></li>)}</ul>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={switchPath(path, other)} hreflang={other} lang={other}>{u('langName', lang)}</a>
      <a class="icon-btn" href={href(lang, '/e-services/tracking')} aria-label={u('track', lang)} title={u('track', lang)}><Icon name="search" size={19} /></a>
      <a class="btn btn-primary btn-sm quote-btn" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
      <button class="burger" id="burger" type="button" aria-controls="mobile-nav" aria-expanded="false" aria-label={u('menu', lang)}>
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label={u('menu', lang)}>
    <div class="container">
      <ol class="m-list">
        {mainNav.map((item, i) => (
          <li class:list={[{ 'has-sub': item.children }]}>
            <div class="row">
              <span class="num-label">{String(i + 1).padStart(2, '0')}</span>
              <a href={href(lang, item.path)} aria-current={isActive(item.path) ? 'page' : undefined}>{t(item.label, lang)}</a>
              {item.children && <button class="sub-toggle" type="button" aria-expanded="false" aria-label={t(item.label, lang)}><Icon name="down" size={20} /></button>}
            </div>
            {item.children && <ul class="sub-m">{item.children.map((c) => <li><a href={href(lang, c.path)}>{shortTitle(t(c.label, lang))}</a></li>)}</ul>}
          </li>
        ))}
      </ol>
      <div class="m-actions">
        <a class="btn btn-primary btn-block" href={href(lang, '/e-services/quote')}>{u('quote', lang)}</a>
        <a class="btn btn-outline btn-block" href={href(lang, '/e-services/tracking')}>{u('track', lang)}</a>
        <a class="btn btn-outline btn-block" href={switchPath(path, other)} hreflang={other}>{u('langName', lang)}</a>
      </div>
      <p class="m-contact"><a href={`tel:${site.contact.phone}`} dir="ltr" class="ltr">{site.contact.phoneDisplay}</a> · <a href={`mailto:${site.contact.email}`} dir="ltr" class="ltr">{site.contact.email}</a></p>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header')!;
  const burger = document.getElementById('burger')!;
  burger.addEventListener('click', () => {
    const open = header.classList.toggle('menu-open');
    burger.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-open', open);
  });
  header.querySelectorAll<HTMLButtonElement>('.sub-toggle').forEach((b) =>
    b.addEventListener('click', () => {
      const open = b.closest('li')!.classList.toggle('sub-open');
      b.setAttribute('aria-expanded', String(open));
    }),
  );
  const onScroll = () => header.classList.toggle('scrolled', window.scrollY > 20);
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .site-header { position: fixed; inset-inline: 0; top: 0; z-index: 50; transition: background .35s var(--ease), box-shadow .35s var(--ease); }
  .site-header { background: #fff; box-shadow: 0 1px 0 var(--line); }
  .site-header.scrolled { background: rgba(255, 255, 255, .96); backdrop-filter: blur(14px); box-shadow: 0 1px 0 var(--line), 0 10px 30px -20px rgba(36, 80, 145, .25); }
  .site-header.menu-open { backdrop-filter: none; background: #fff; }
  .logo-light { display: none; }
  /* transparent header over a full-bleed photo hero */
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) { background: transparent; box-shadow: none; }
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .logo-dark { display: none; }
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .logo-light { display: block; }
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .nav > ul > li > a,
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .lang,
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .icon-btn { color: #fff; }
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .icon-btn { box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .45); }
  :global(body:has(main > .photo-hero:first-child)) .site-header:not(.scrolled):not(.menu-open) .burger { background: rgba(255, 255, 255, .14); }
  .header-inner { display: flex; align-items: center; gap: 2rem; min-height: var(--header-h); transition: min-height .35s var(--ease); }
  .scrolled .header-inner { min-height: 72px; }
  .brand { flex-shrink: 0; }
  .brand :global(img) { transition: height .35s var(--ease); }
  .scrolled .brand :global(img) { height: 52px !important; }
  @media (max-width: 560px) { .brand :global(img) { height: 50px !important; } .scrolled .brand :global(img) { height: 44px !important; } }

  .nav { flex: 1; display: flex; justify-content: center; }
  .nav > ul { list-style: none; margin: 0; padding: 0; display: flex; align-items: center; gap: .2rem; }
  .nav > ul > li { position: relative; }
  .nav > ul > li > a { display: inline-flex; align-items: center; gap: .3rem; padding: .55rem .8rem; color: var(--ink); font-size: .93rem; font-weight: 400; white-space: nowrap; position: relative; }
  .nav > ul > li > a::after { content: ''; position: absolute; inset-inline: .85rem; bottom: .2rem; height: 2px; background: var(--coral); transform: scaleX(0); transform-origin: var(--origin, left); transition: transform .35s var(--ease); }
  :global(html[dir='rtl']) .nav > ul > li > a::after { --origin: right; }
  .nav > ul > li > a:hover::after, .nav > ul > li > a[aria-current='page']::after { transform: scaleX(1); }
  .nav > ul > li > a[aria-current='page'] { font-weight: 500; color: var(--petrol); }
  .nav :global(.caret) { color: var(--coral); transition: transform .3s var(--ease); }
  .has-sub:hover > a :global(.caret) { transform: rotate(180deg); }

  .panel {
    position: absolute; top: calc(100% + .6rem); inset-inline-start: 0; min-width: 250px; list-style: none; margin: 0; padding: .6rem;
    background: #fff; box-shadow: var(--shadow-lg); border-radius: var(--radius); border: 1px solid var(--line);
    opacity: 0; visibility: hidden; transform: translateY(8px); transition: all .3s var(--ease);
  }
  .panel::before { content: ''; position: absolute; inset-inline: 0; top: -.8rem; height: .8rem; }
  .has-sub:hover .panel, .has-sub:focus-within .panel { opacity: 1; visibility: visible; transform: none; }
  .panel a { display: block; border-radius: 8px; padding: .55rem .9rem; color: var(--ink); font-size: .93rem; line-height: 1.5; }
  .panel a:hover { background: var(--paper); color: var(--petrol); }
  .header-inner { position: relative; }
  .nav > ul > li.mega { position: static; }
  .mega-panel { display: grid; grid-template-columns: 1fr 230px; gap: .6rem; inset-inline: 0; min-width: 0; top: calc(100% - .4rem); }
  .mega-cats { list-style: none; margin: 0; padding: .3rem; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .1rem .8rem; }
  .mega-item { display: grid !important; grid-template-columns: 40px minmax(0, 1fr); gap: .8rem; align-items: start; padding: .7rem .8rem !important; }
  .mi-icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--teal-50); color: var(--petrol); transition: background .25s, color .25s; }
  .mega-item:hover .mi-icon { background: var(--petrol); color: #fff; }
  .mi-text strong { display: block; font-weight: 600; color: var(--petrol); font-size: .95rem; }
  .mi-text small { display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; color: var(--muted); font-size: .8rem; line-height: 1.5; }
  .code { flex-shrink: 0; font-size: .7rem; font-weight: 600; color: var(--coral-ink); direction: ltr; letter-spacing: .05em; }
  .mega-promo { border-radius: 10px; background: var(--petrol); color: var(--cream) !important; padding: 1.4rem !important; display: flex !important; flex-direction: column; gap: .6rem; }
  .mega-promo:hover { background: var(--navy-900) !important; }
  .mega-promo strong { font-size: 1.15rem; font-weight: 500; line-height: 1.35; }
  .mega-promo > span:not(.slash):not(.go) { font-size: .88rem; color: rgba(255, 255, 255, .7); }
  .mega-promo .go { margin-top: auto; display: inline-flex; align-items: center; gap: .4rem; color: var(--coral); font-size: .9rem; }

  .actions { display: flex; align-items: center; gap: .9rem; flex-shrink: 0; }
  .lang { font-size: .9rem; font-weight: 500; color: var(--petrol); padding: .4rem .2rem; border-bottom: 1px solid transparent; }
  .lang:hover { border-color: var(--coral); }
  .icon-btn { width: 40px; height: 40px; border-radius: 8px; display: grid; place-items: center; color: var(--petrol); box-shadow: inset 0 0 0 1px rgba(36, 80, 145, .2); transition: background .3s, color .3s; }
  .icon-btn:hover { background: var(--petrol); color: var(--cream); }

  .burger { display: none; width: 44px; height: 44px; border-radius: 8px; background: var(--petrol); border: 0; cursor: pointer; position: relative; }
  .burger span { position: absolute; inset-inline-start: 12px; height: 2px; border-radius: 2px; background: #fff; transition: transform .3s var(--ease), opacity .3s, width .3s; }
  .burger span:nth-child(1) { top: 15px; width: 20px; } .burger span:nth-child(2) { top: 21px; width: 14px; background: var(--coral); } .burger span:nth-child(3) { top: 27px; width: 20px; }
  .menu-open .burger span:nth-child(1) { transform: translateY(6px) rotate(45deg); }
  .menu-open .burger span:nth-child(2) { opacity: 0; }
  .menu-open .burger span:nth-child(3) { transform: translateY(-6px) rotate(-45deg); }

  .mobile-nav { display: none; }

  @media (max-width: 1240px) {
    .nav, .lang { display: none; }
    .actions { margin-inline-start: auto; }
    .burger { display: inline-block; }
    .mobile-nav {
      display: block; position: fixed; inset-inline: 0; bottom: 0; top: 72px; background: #fff; overflow-y: auto;
      opacity: 0; visibility: hidden; transition: opacity .3s var(--ease), visibility .3s; padding-block: 1.5rem 3rem;
    }
    .menu-open .mobile-nav { opacity: 1; visibility: visible; }
    .menu-open .header-inner { min-height: 72px; }
    .m-list { list-style: none; padding: 0; margin: 0; }
    .m-list > li { border-bottom: 1px solid var(--line); }
    .row { display: flex; align-items: center; gap: 1rem; }
    .row a { flex: 1; display: block; padding: .9rem 0; color: var(--petrol); font-size: 1.15rem; font-weight: 500; }
    .row a[aria-current='page'] { color: var(--coral-ink); }
    .sub-toggle { background: none; border: 0; color: var(--coral); padding: .8rem; cursor: pointer; transition: transform .3s; }
    .sub-open .sub-toggle { transform: rotate(180deg); }
    .sub-m { display: none; list-style: none; padding: 0 0 1rem; margin: 0; padding-inline-start: 2.6rem; }
    .sub-open .sub-m { display: grid; gap: .1rem; }
    .sub-m a { display: block; padding: .4rem 0; color: var(--muted); }
    .m-actions { display: grid; gap: .6rem; margin-top: 2rem; }
    .m-contact { margin-top: 1.5rem; color: var(--muted); }
    :global(body.nav-open) { overflow: hidden; }
  }
  @media (max-width: 560px) { .quote-btn { display: none; } .icon-btn { width: 46px; height: 46px; } }
</style>
