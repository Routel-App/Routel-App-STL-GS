---
import { type Lang, href, t } from '../i18n/ui';
import { visiblePorts, seaName } from '../data/network';
interface Props { lang: Lang }
const { lang } = Astro.props;
const ports = visiblePorts();
// Simplified outline of Saudi Arabia (viewBox 0-100, x = longitude, y = latitude)
const ksa = 'M0.5 24 2 16 12 3 22 0 35 6 47 17 56 18 61 22 65 25 72 35 77 47 79 49 84 57 98 62 95 75 81 81 67 84 53 92 41 91 38 94 30 82 22 66 17 49 6 29Z';
---
<div class="map">
  <svg viewBox="-8 -8 116 112" role="img" aria-label={lang === 'ar' ? 'خريطة موانئ المملكة' : 'Map of Saudi ports'}>
    <defs>
      <linearGradient id="land" x1="0" x2="1" y1="0" y2="1"><stop offset="0" stop-color="#0e4f4d" /><stop offset="1" stop-color="#073b3a" /></linearGradient>
    </defs>
    <path d="M-8 20 0 22 6 29 17 49 22 66 30 82 38 94 40 104 -8 104Z" fill="#a7c5c2" opacity=".14" />
    <path d="M60 18 72 35 77 47 84 57 100 58 108 40 108 10Z" fill="#a7c5c2" opacity=".14" />
    <text x="12" y="90" class="sea">{t(seaName('red'), lang)}</text>
    <text x="95" y="47" class="sea">{t(seaName('gulf'), lang)}</text>
    <path d={ksa} fill="url(#land)" stroke="#a7c5c2" stroke-width=".5" stroke-opacity=".6" />
    <circle cx="51" cy="44" r="1.3" fill="#d7e6e4" /><text x="51" y="50" class="city">{lang === 'ar' ? 'الرياض' : 'Riyadh'}</text>
    {ports.map((p) => (
      <a href={href(lang, `/network/ports/${p.slug}`)} class="pin">
        <circle cx={p.map.x} cy={p.map.y} r="4.5" class="pulse" />
        <circle cx={p.map.x} cy={p.map.y} r="2.2" class="dot" />
        <title>{t(p.name, lang)}</title>
      </a>
    ))}
  </svg>
</div>
<style>
  .map { background: radial-gradient(circle at 50% 40%, #0b4a48, var(--navy-900)); border-radius: calc(var(--radius) * 1.4); padding: 1rem; }
  svg { width: 100%; height: auto; }
  .sea { fill: #a7c5c2; font-size: 3.2px; font-weight: 600; text-anchor: middle; }
  .city { fill: #d7e6e4; font-size: 3px; text-anchor: middle; }
  .dot { fill: var(--accent); stroke: #fff; stroke-width: .6; }
  .pulse { fill: var(--accent); opacity: .3; transform-box: fill-box; transform-origin: center; animation: pulse 2.2s ease-out infinite; }
  .pin:hover .dot { fill: #fff; }
  @keyframes pulse { from { transform: scale(.6); opacity: .5; } to { transform: scale(1.8); opacity: 0; } }
</style>
