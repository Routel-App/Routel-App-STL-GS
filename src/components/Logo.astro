---
/**
 * Temporary text logo. To use the official logo, put it in public/logo.svg
 * and set USE_IMAGE_LOGO = true.
 */
interface Props { light?: boolean }
const { light = false } = Astro.props;
const USE_IMAGE_LOGO = false;
---
{USE_IMAGE_LOGO ? (
  <img src="/logo.svg" alt="STL Global Solutions" height="44" class="logo-img" />
) : (
  <span class:list={['logo', { light }]}>
    <svg viewBox="0 0 48 48" width="42" height="42" aria-hidden="true">
      <rect width="48" height="48" rx="12" fill="#0a2647" />
      <path d="M10 30c4 0 4-3 8-3s4 3 8 3 4-3 8-3 4 3 4 3" stroke="#2dc3c0" stroke-width="3" fill="none" stroke-linecap="round" />
      <path d="M10 37c4 0 4-3 8-3s4 3 8 3 4-3 8-3 4 3 4 3" stroke="#f08a24" stroke-width="3" fill="none" stroke-linecap="round" />
      <path d="M17 22h14l-3-11h-8z" fill="#fff" />
    </svg>
    <span class="logo-text"><b>STL</b><small>Global Solutions</small></span>
  </span>
)}
<style>
  .logo { display: inline-flex; align-items: center; gap: .6rem; color: var(--navy-800); direction: ltr; }
  .logo.light { color: #fff; }
  .logo-text { display: flex; flex-direction: column; line-height: 1; }
  .logo-text b { font-size: 1.45rem; letter-spacing: .06em; }
  .logo-text small { font-size: .7rem; letter-spacing: .12em; text-transform: uppercase; opacity: .75; margin-top: 3px; }
</style>
