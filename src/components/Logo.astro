---
/**
 * STL Global Forwarding official logo — vector (SVG) traced from the brand board.
 *  - variant "color": primary full-colour logo (transparent background)
 *  - variant "white": the board's official "White on Dark" variant, for dark backgrounds
 * PNG fallbacks stay in public/brand/ (stl-logo*.png) for email/social use.
 */
interface Props { variant?: 'color' | 'white'; height?: number }
const { variant = 'color', height = 46 } = Astro.props;
const SRC = { color: '/brand/stl-logo.svg', white: '/brand/stl-logo-white.svg' };
const RATIO = 366 / 158;
---
<span class="logo">
  <img src={SRC[variant]} alt="STL Global Forwarding" width={Math.round(height * RATIO)} height={height} decoding="async" style={`height:${height}px`} />
</span>
<style>
  .logo { display: inline-flex; align-items: center; line-height: 0; }
  .logo img { width: auto; max-width: 100%; }
</style>
