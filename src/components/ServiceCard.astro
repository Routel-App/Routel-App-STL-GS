---
import type { Service } from '../data/services';
import { categoryBySlug, serviceHref } from '../data/services';
import { servicePhoto } from '../data/photos';
import { type Lang, href, t, u } from '../i18n/ui';
import Icon from './Icon.astro';
import ServiceArt from './ServiceArt.astro';
interface Props { lang: Lang; s: Service }
const { lang, s } = Astro.props;
const photo = servicePhoto(s);
---
<a class="card service-card reveal" href={href(lang, serviceHref(s))}>
  <div class="sc-media">
    <ServiceArt art={categoryBySlug(s.category)!.art} photo={photo} />
    <span class="icon-badge"><Icon name={s.icon} /></span>
  </div>
  <div class="row">
    {s.code && <span class="tag">{s.code}</span>}
  </div>
  <h3>{t(s.title, lang)}</h3>
  <p>{t(s.short, lang)}</p>
  <span class="link-arrow">{u('learnMore', lang)} <Icon name="arrow" class="flip" /></span>
</a>
<style>
  .service-card { --card-pad: clamp(1.6rem, 3vw, 2.2rem); padding-top: 0 !important; }
  .sc-media { position: relative; aspect-ratio: 16 / 9; margin: 0 calc(var(--card-pad, 1.8rem) * -1) 2rem; }
  .sc-media :global(.service-art) { position: absolute; inset: 0; }
  .sc-media .icon-badge { position: absolute; bottom: -22px; inset-inline-start: var(--card-pad, 1.8rem); z-index: 1; background: #fff; color: var(--petrol); box-shadow: var(--shadow); margin: 0; }
  .row { display: flex; justify-content: flex-end; min-height: 1.4rem; }
</style>
