---
import { site, phoneHref, whatsappHref } from '../config/site';
import { type Lang, href, t, u } from '../i18n/ui';
import { eServices } from '../i18n/nav';
import { categories } from '../data/services';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const companyLinks = [
  { label: 'about', path: '/about' },
  { label: 'whyStl', path: '/why-stl' },
  { label: 'careers', path: '/careers' },
  { label: 'news', path: '/media/news' },
  { label: 'qhse', path: '/qhse' },
  { label: 'sustainability', path: '/sustainability' },
  { label: 'faq', path: '/faq' },
] as const;
const socials = [
  { icon: 'linkedin', url: site.social.linkedin, label: 'LinkedIn' },
  { icon: 'x', url: site.social.x, label: 'X' },
  { icon: 'instagram', url: site.social.instagram, label: 'Instagram' },
  { icon: 'youtube', url: site.social.youtube, label: 'YouTube' },
  { icon: 'whatsapp', url: whatsappHref(), label: 'WhatsApp' },
].filter((s) => s.url);
const legalLine = [
  site.legal.crNumber && `${u('crLine', lang)} ${site.legal.crNumber}`,
  site.legal.tgaLicense && `${u('tgaLine', lang)} ${site.legal.tgaLicense}`,
  site.legal.vatNumber && `${u('vatLine', lang)} ${site.legal.vatNumber}`,
].filter(Boolean);
---
<footer class="site-footer">
  <div class="container">
    <div class="statement">
      <p><span class="slash"></span>{site.tagline[lang]}</p>
      <a class="btn btn-primary" href={href(lang, '/e-services/quote')}>{u('quote', lang)} <Icon name="arrow" class="flip" /></a>
    </div>
    <div class="footer-top">
      <div class="footer-brand">
        <Logo variant="white" height={56} />
        <p>{u('footerAbout', lang)}</p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={20} /></a>
          ))}
        </div>
      </div>
      <div class="newsletter">
        <h3>{u('newsletterTitle', lang)}</h3>
        <p>{u('newsletterText', lang)}</p>
        <form class="news-form" data-form="newsletter" data-success={u('subscribed', lang)}>
          <label class="visually-hidden" for="nl-email">{u('emailPlaceholder', lang)}</label>
          <input id="nl-email" type="email" name="email" required placeholder={u('emailPlaceholder', lang)} />
          <button class="btn btn-primary" type="submit">{u('subscribe', lang)}</button>
        </form>
        <p class="form-msg" data-msg role="status"></p>
      </div>
    </div>

    <div class="footer-cols">
      <div>
        <h4>{u('services', lang)}</h4>
        <ul>{categories.map((c) => <li><a href={href(lang, `/services/${c.slug}`)}>{t(c.title, lang)}</a></li>)}</ul>
      </div>
      <div>
        <h4>{u('company', lang)}</h4>
        <ul>{companyLinks.map((l) => <li><a href={href(lang, l.path)}>{u(l.label, lang)}</a></li>)}</ul>
      </div>
      <div>
        <h4>{u('eservices', lang)}</h4>
        <ul>
          {eServices.map((l) => <li><a href={href(lang, l.path)}>{t(l.label, lang)}</a></li>)}
          {site.downloads.companyProfile && <li><a href={site.downloads.companyProfile} download>{u('companyProfile', lang)}</a></li>}
        </ul>
      </div>
      <div>
        <h4>{u('contact', lang)}</h4>
        <ul class="contact-list">
          <li><Icon name="phone" size={18} /><a href={phoneHref} dir="ltr" class="ltr">{site.contact.phoneDisplay}</a></li>
          <li><Icon name="whatsapp" size={18} /><a href={whatsappHref()} target="_blank" rel="noopener">{lang === 'ar' ? 'واتساب' : 'WhatsApp'}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${site.contact.email}`} dir="ltr" class="ltr">{site.contact.email}</a></li>
          <li><Icon name="pin" size={18} /><span>{t(site.contact.hqAddress, lang)}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      {legalLine.length > 0 && <p class="reg">STL Global Forwarding — {legalLine.join(' — ')}</p>}
      <div class="bottom">
        <span>© {year} STL Global Forwarding. {u('rights', lang)}</span>
        <nav class="legal-links" aria-label={u('legal', lang)}>
          <a href={href(lang, '/legal/privacy')}>{u('privacy', lang)}</a>
          <a href={href(lang, '/legal/terms')}>{u('terms', lang)}</a>
          <a href={href(lang, '/legal/shipping-terms')}>{u('shippingTerms', lang)}</a>
          <a href={href(lang, '/legal/cookies')}>{u('cookies', lang)}</a>
          <button type="button" class="linklike" data-cookie-settings>{u('manage', lang)}</button>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--petrol); color: rgba(244, 239, 230, .62); padding-top: clamp(3.5rem, 7vw, 6rem); font-size: .95rem; position: relative; overflow: hidden; }
  .site-footer a { color: rgba(244, 239, 230, .82); }
  .site-footer a:hover { color: var(--coral); }
  .statement { display: flex; justify-content: space-between; align-items: flex-end; gap: 2rem; flex-wrap: wrap; padding-bottom: clamp(2.5rem, 5vw, 4rem); border-bottom: 1px solid var(--line-dark); }
  .statement p { margin: 0; color: var(--cream); font-size: clamp(1.6rem, 3vw, 2.4rem); font-weight: 600; line-height: 1.25; letter-spacing: -.02em; max-width: 900px; }
  :global(html[lang='ar']) .statement p { letter-spacing: 0; line-height: 1.4; }
  .footer-top { display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); padding-block: 3rem; border-bottom: 1px solid var(--line-dark); align-items: start; }
  .footer-brand p { margin: 1.4rem 0; max-width: 420px; }
  .socials { display: flex; gap: .5rem; }
  .socials a { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: rgba(244, 239, 230, .07); transition: all .3s var(--ease); }
  .socials a:hover { background: var(--coral); color: #fff; }
  .newsletter h3 { color: var(--cream); font-size: 1.3rem; font-weight: 500; }
  .news-form { display: flex; gap: .4rem; }
  .news-form input { background: rgba(255, 255, 255, .07); border-color: var(--line-dark); color: #fff; }
  .news-form input:focus { background: rgba(244, 239, 230, .1); }
  .news-form input::placeholder { color: rgba(244, 239, 230, .4); }
  .form-msg { margin-top: .5rem; color: var(--mint); min-height: 1.5em; }
  .footer-cols { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); padding-block: 3rem; }
  .footer-cols h4 { color: var(--cream); font-size: 1rem; font-weight: 500; margin-bottom: 1.2rem; display: flex; align-items: center; gap: .6rem; }
  .footer-cols ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .6rem; }
  .contact-list li { display: flex; gap: .7rem; align-items: flex-start; }
  .contact-list :global(.icon) { flex-shrink: 0; margin-top: .35rem; color: var(--coral); width: 16px; height: 16px; }
  .footer-legal { border-top: 1px solid var(--line-dark); padding-block: 1.6rem; font-size: .84rem; }
  .reg { color: rgba(244, 239, 230, .45); }
  .bottom { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .legal-links { display: flex; flex-wrap: wrap; gap: 1.4rem; }
  .linklike { background: none; border: 0; color: rgba(244, 239, 230, .82); font: inherit; cursor: pointer; padding: 0; }
  .linklike:hover { color: var(--coral); }
</style>
