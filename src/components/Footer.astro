---
import { site } from '../config/site';
import { type Lang, href, t, u } from '../i18n/ui';
import { eServices } from '../i18n/nav';
import { services } from '../data/services';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
const year = new Date().getFullYear();
const companyLinks = [
  { label: 'about', path: '/about' },
  { label: 'whyStl', path: '/why-stl' },
  { label: 'careers', path: '/careers' },
  { label: 'news', path: '/media/news' },
  { label: 'qhse', path: '/qhse' },
  { label: 'sustainability', path: '/sustainability' },
  { label: 'faq', path: '/faq' },
] as const;
const socials = [
  { icon: 'linkedin', url: site.social.linkedin, label: 'LinkedIn' },
  { icon: 'x', url: site.social.x, label: 'X' },
  { icon: 'instagram', url: site.social.instagram, label: 'Instagram' },
  { icon: 'youtube', url: site.social.youtube, label: 'YouTube' },
  { icon: 'whatsapp', url: `https://wa.me/${site.contact.whatsapp}`, label: 'WhatsApp' },
];
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <Logo variant="white" height={56} />
        <p>{u('footerAbout', lang)}</p>
        <div class="socials">
          {socials.map((s) => (
            <a href={s.url} target="_blank" rel="noopener" aria-label={s.label}><Icon name={s.icon} size={20} /></a>
          ))}
        </div>
      </div>
      <div class="newsletter">
        <h3>{u('newsletterTitle', lang)}</h3>
        <p>{u('newsletterText', lang)}</p>
        <form class="news-form" data-form="newsletter" data-success={u('subscribed', lang)}>
          <label class="visually-hidden" for="nl-email">{u('emailPlaceholder', lang)}</label>
          <input id="nl-email" type="email" name="email" required placeholder={u('emailPlaceholder', lang)} />
          <button class="btn btn-primary" type="submit">{u('subscribe', lang)}</button>
        </form>
        <p class="form-msg" data-msg role="status"></p>
      </div>
    </div>

    <div class="footer-cols">
      <div>
        <h4>{u('services', lang)}</h4>
        <ul>{services.slice(0, 8).map((s) => <li><a href={href(lang, `/services/${s.slug}`)}>{t(s.title, lang).replace(/\s*\(.*\)$/, '')}</a></li>)}</ul>
      </div>
      <div>
        <h4>{u('company', lang)}</h4>
        <ul>{companyLinks.map((l) => <li><a href={href(lang, l.path)}>{u(l.label, lang)}</a></li>)}</ul>
      </div>
      <div>
        <h4>{u('eservices', lang)}</h4>
        <ul>
          {eServices.map((l) => <li><a href={href(lang, l.path)}>{t(l.label, lang)}</a></li>)}
          <li><a href={site.downloads.companyProfile} download>{u('companyProfile', lang)}</a></li>
        </ul>
      </div>
      <div>
        <h4>{u('contact', lang)}</h4>
        <ul class="contact-list">
          <li><Icon name="phone" size={18} /><a href={`tel:${site.contact.unifiedPhone}`} class="ltr">{site.contact.unifiedPhone}</a></li>
          <li><Icon name="mail" size={18} /><a href={`mailto:${site.contact.emailInfo}`} class="ltr">{site.contact.emailInfo}</a></li>
          <li><Icon name="pin" size={18} /><span>{t(site.contact.hqAddress, lang)}</span></li>
          <li><Icon name="clock" size={18} /><span>{t(site.contact.workingHours, lang)}</span></li>
        </ul>
      </div>
    </div>

    <div class="footer-legal">
      <p class="reg">
        STL Global Solutions — {u('crLine', lang)} {site.legal.crNumber} — {u('tgaLine', lang)} {site.legal.tgaLicense} — {u('vatLine', lang)} {site.legal.vatNumber}
      </p>
      <div class="bottom">
        <span>© {year} STL Global Solutions. {u('rights', lang)}</span>
        <nav class="legal-links" aria-label={u('legal', lang)}>
          <a href={href(lang, '/legal/privacy')}>{u('privacy', lang)}</a>
          <a href={href(lang, '/legal/terms')}>{u('terms', lang)}</a>
          <a href={href(lang, '/legal/shipping-terms')}>{u('shippingTerms', lang)}</a>
          <a href={href(lang, '/legal/cookies')}>{u('cookies', lang)}</a>
          <button type="button" class="linklike" data-cookie-settings>{u('manage', lang)}</button>
        </nav>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy-900); color: rgba(244, 239, 230, .62); padding-top: clamp(4rem, 8vw, 6.5rem); font-size: .95rem; }
  .site-footer a { color: rgba(244, 239, 230, .82); }
  .site-footer a:hover { color: #fff; }
  .footer-top { display: grid; gap: 3rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); padding-bottom: 3.5rem; border-bottom: 1px solid var(--line-dark); align-items: end; }
  .footer-brand p { margin: 1.6rem 0; max-width: 420px; }
  .socials { display: flex; gap: .5rem; }
  .socials a { width: 42px; height: 42px; display: grid; place-items: center; border: 1px solid var(--line-dark); transition: all .3s var(--ease); }
  .socials a:hover { background: var(--cream); color: var(--petrol); border-color: var(--cream); }
  .newsletter h3 { color: var(--cream); font-size: 1.5rem; font-weight: 400; }
  .news-form { display: flex; gap: 0; border: 1px solid var(--line-dark); padding: .4rem; }
  .news-form input { background: transparent; border: 0; color: var(--cream); }
  .news-form input:focus { box-shadow: none; }
  .news-form input::placeholder { color: rgba(244, 239, 230, .4); }
  .news-form .btn { background: var(--cream); color: var(--petrol); }
  .form-msg { margin-top: .5rem; color: var(--mint); min-height: 1.5em; }
  .footer-cols { display: grid; gap: 2.5rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); padding-block: 3.5rem; }
  .footer-cols h4 { color: var(--cream); font-size: .72rem; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; margin-bottom: 1.4rem; }
  :global(html[lang='ar']) .footer-cols h4 { letter-spacing: 0; font-size: .95rem; }
  .footer-cols ul { list-style: none; padding: 0; margin: 0; display: grid; gap: .7rem; }
  .contact-list li { display: flex; gap: .7rem; align-items: flex-start; }
  .contact-list :global(.icon) { flex-shrink: 0; margin-top: .35rem; color: var(--coral); width: 16px; height: 16px; }
  .footer-legal { border-top: 1px solid var(--line-dark); padding-block: 1.8rem; font-size: .84rem; }
  .reg { color: rgba(244, 239, 230, .45); }
  .bottom { display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; }
  .legal-links { display: flex; flex-wrap: wrap; gap: 1.4rem; }
  .linklike { background: none; border: 0; color: rgba(244, 239, 230, .82); font: inherit; cursor: pointer; padding: 0; }
  .linklike:hover { color: #fff; }
</style>
