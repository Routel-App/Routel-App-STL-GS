---
/**
 * Brand illustration: container ship at dusk with a quay on the horizon.
 * Vector, in the STL palette. Replace with a real photo by swapping this
 * component for an <img> if preferred.
 */
interface Props { animated?: boolean }
const { animated = true } = Astro.props;
const pal = ['#ff7058', '#B9CBEA', '#f4efe6', '#2B5CA3', '#f7a58f', '#1B4180', '#DCE5F4', '#ff8b74'];
// container stacks on deck: [x, columns-high]
const bays = [210, 252, 294, 336, 378, 420, 462, 504, 546, 588];
const heights = [3, 4, 4, 5, 4, 5, 4, 4, 3, 3];
const cranes = [120, 230, 650, 760];
---
<svg class:list={['scene', { animated }]} viewBox="0 0 900 1000" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  <defs>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#245091" />
      <stop offset=".38" stop-color="#3A69B0" />
      <stop offset=".68" stop-color="#d99a85" />
      <stop offset=".8" stop-color="#ffd2c2" />
    </linearGradient>
    <linearGradient id="sea" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#2f6b67" />
      <stop offset=".35" stop-color="#2B5CA3" />
      <stop offset="1" stop-color="#0F2550" />
    </linearGradient>
    <radialGradient id="glow" cx=".5" cy=".5" r=".5">
      <stop offset="0" stop-color="#ffb4a2" stop-opacity=".9" />
      <stop offset="1" stop-color="#ffb4a2" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="hull" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#1B4180" />
      <stop offset="1" stop-color="#0F2550" />
    </linearGradient>
  </defs>
  <g transform="translate(0 -150)">

  <!-- sky -->
  <rect width="900" height="620" fill="url(#sky)" />
  <!-- brand slashes of light -->
  <g opacity=".14" fill="#f4efe6">
    <path d="M520 0h70L420 620h-70z" />
    <path d="M640 0h22L492 620h-22z" />
    <path d="M150 0h40L20 620h-40z" />
  </g>
  <!-- sun -->
  <circle cx="610" cy="560" r="230" fill="url(#glow)" />
  <circle cx="610" cy="560" r="108" fill="#ff7058" />

  <!-- distant quay & cranes -->
  <g fill="#2a5e5b" opacity=".85">
    <rect x="0" y="566" width="900" height="16" />
    {cranes.map((x) => (
      <g>
        <path d={`M${x} 566 l18 -120 h8 l18 120 h-8 l-14 -100 l-14 100z`} />
        <rect x={x - 40} y="440" width="140" height="9" />
        <rect x={x + 6} y="420" width="30" height="22" />
        <path d={`M${x + 22} 420 l-30 -40 h6 l30 40z`} />
      </g>
    ))}
    {[40, 70, 95, 300, 330, 360, 390, 820, 850].map((x, i) => (
      <rect x={x} y={566 - 14 * (1 + (i % 3))} width="26" height={14 * (1 + (i % 3))} />
    ))}
  </g>

  <!-- sea -->
  <rect y="580" width="900" height="600" fill="url(#sea)" />
  <!-- sun reflection -->
  <g fill="#ff8b74" opacity=".75">
    <rect x="540" y="596" width="140" height="4" />
    <rect x="560" y="614" width="100" height="4" opacity=".8" />
    <rect x="575" y="634" width="70" height="3" opacity=".6" />
    <rect x="590" y="656" width="40" height="3" opacity=".45" />
  </g>

  <!-- ship -->
  <g class="ship">
    <!-- containers -->
    {bays.map((x, i) =>
      Array.from({ length: heights[i] }, (_, j) => (
        <g>
          <rect x={x} y={640 - (j + 1) * 24} width="40" height="22" fill={pal[(i * 3 + j * 5) % pal.length]} />
          <rect x={x} y={640 - (j + 1) * 24} width="40" height="22" fill="none" stroke="#0F2550" stroke-opacity=".25" />
          <path d={`M${x + 10} ${642 - (j + 1) * 24}v18M${x + 20} ${642 - (j + 1) * 24}v18M${x + 30} ${642 - (j + 1) * 24}v18`} stroke="#0F2550" stroke-opacity=".12" />
        </g>
      )),
    )}
    <!-- bridge -->
    <rect x="640" y="548" width="74" height="92" fill="#f4efe6" />
    <rect x="632" y="540" width="90" height="12" fill="#f4efe6" />
    <rect x="646" y="560" width="62" height="10" fill="#1B4180" />
    <rect x="646" y="580" width="62" height="5" fill="#1B4180" opacity=".5" />
    <rect x="670" y="504" width="16" height="36" fill="#ff7058" />
    <rect x="667" y="498" width="22" height="8" fill="#0F2550" />
    <!-- hull -->
    <path d="M150 640 H770 L742 724 H214 Q170 700 150 640Z" fill="url(#hull)" />
    <path d="M150 640 H770 L766 652 H158Z" fill="#ff7058" />
    <path d="M206 708 H748 L742 724 H214Z" fill="#B9CBEA" opacity=".35" />
    <!-- forward slash on hull (brand mark) -->
    <path d="M300 660 h14 l-14 40 h-14z" fill="#ff7058" />
    <path d="M322 660 h5 l-14 40 h-5z" fill="#f4efe6" opacity=".7" />
  </g>

  <!-- waves -->
  <g class="w w1" fill="#1B4180" opacity=".95">
    <path d="M-100 712 C-40 700 20 724 80 712 S200 700 260 712 380 724 440 712 560 700 620 712 740 724 800 712 920 700 980 712 1100 724 1160 712 V1200 H-100Z" />
  </g>
  <g class="w w2" fill="#245091">
    <path d="M-100 760 C-30 744 40 776 110 760 S250 744 320 760 460 776 530 760 670 744 740 760 880 776 950 760 1090 744 1160 760 V1200 H-100Z" />
  </g>
  <g class="w w3" fill="#0F2550">
    <path d="M-100 830 C-20 812 60 848 140 830 S300 812 380 830 540 848 620 830 780 812 860 830 1020 848 1100 830 V1200 H-100Z" />
  </g>
  <g stroke="#B9CBEA" stroke-opacity=".35" stroke-width="2" class="w w2">
    <path d="M80 790 h60 M300 805 h40 M560 785 h70 M760 812 h40" />
  </g>
  </g>
</svg>

<style>
  .scene { width: 100%; height: 100%; display: block; }
  .animated .ship { animation: bob 6s ease-in-out infinite; transform-origin: 460px 550px; }
  .animated .w { animation: sway 9s ease-in-out infinite alternate; }
  .animated .w2 { animation-duration: 7s; animation-direction: alternate-reverse; }
  .animated .w3 { animation-duration: 11s; }
  @keyframes bob { 50% { transform: translateY(6px) rotate(-.6deg); } }
  @keyframes sway { to { transform: translateX(-60px); } }
  @media (prefers-reduced-motion: reduce) { .animated .ship, .animated .w { animation: none; } }
</style>
