---
/**
 * Brand illustrations, one per business unit (vector, STL palette).
 * Used wherever no real photo is set. Pass `photo` to show a photo on top
 * (the illustration stays underneath as a fallback if the photo fails).
 */
interface Props { art: 'ship' | 'crane' | 'plane' | 'truck' | 'event' | 'marine'; photo?: string; class?: string; alt?: string }
const { art, photo, class: cls = '', alt = '' } = Astro.props;
const id = `sa-${art}`;
const boxes = ['#ff7058', '#B9CBEA', '#f4efe6', '#2B5CA3', '#f7a58f', '#DCE5F4', '#ff8b74', '#1B4180'];
---
<div class:list={['service-art', cls]}>
  <svg viewBox="0 0 600 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id={`${id}-sky`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#245091" />
        <stop offset=".55" stop-color="#3A69B0" />
        <stop offset="1" stop-color="#e3a893" />
      </linearGradient>
      <linearGradient id={`${id}-sea`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" stop-color="#1d5f5c" />
        <stop offset="1" stop-color="#0F2550" />
      </linearGradient>
    </defs>
    <rect width="600" height="400" fill={`url(#${id}-sky)`} />
    <g opacity=".12" fill="#f4efe6"><path d="M380 0h46L300 400h-46z" /><path d="M462 0h14L350 400h-14z" /></g>
    <circle cx="430" cy="250" r="62" fill="#ff7058" />

    {art === 'ship' && (
      <g>
        <rect y="262" width="600" height="138" fill={`url(#${id}-sea)`} />
        <g fill="#ff8b74" opacity=".6"><rect x="380" y="276" width="100" height="3" /><rect x="400" y="292" width="60" height="3" /></g>
        {[0, 1, 2, 3, 4, 5, 6, 7, 8].map((i) => [0, 1, 2, 3].slice(0, 2 + ((i * 7) % 3)).map((r) => (
          <rect x={150 + i * 34} y={232 - r * 18} width="31" height="16" fill={boxes[(i + r * 3) % boxes.length]} />
        )))}
        <path d="M110 250h400l-28 48H146z" fill="#062f2e" />
        <rect x="118" y="196" width="26" height="54" fill="#1B4180" /><rect x="122" y="202" width="18" height="5" fill="#ffd2c2" />
        <path d="M110 250h400" stroke="#ff7058" stroke-width="3" />
      </g>
    )}

    {art === 'crane' && (
      <g>
        <rect y="300" width="600" height="100" fill="#1B4180" />
        <rect y="300" width="600" height="4" fill="#ff7058" />
        <g fill="#062f2e">
          <rect x="120" y="70" width="14" height="230" />
          <path d="M127 70 300 92v8L127 82z" /><path d="M127 70 70 92v8l57-18z" />
          <rect x="60" y="96" width="30" height="26" />
          <path d="M127 70V40l10 30z" />
        </g>
        <path d="M262 98v118" stroke="#062f2e" stroke-width="2" />
        <path d="M262 216l-34 22M262 216l34 22" stroke="#062f2e" stroke-width="2" />
        <rect x="214" y="238" width="96" height="44" rx="4" fill="#f4efe6" />
        <rect x="224" y="246" width="76" height="6" fill="#B9CBEA" /><rect x="224" y="258" width="76" height="6" fill="#B9CBEA" /><rect x="224" y="270" width="76" height="6" fill="#B9CBEA" />
        <rect x="340" y="268" width="210" height="18" fill="#2B5CA3" />
        {[350, 380, 410, 440, 470, 500, 530].map((x) => <circle cx={x} cy="294" r="7" fill="#062f2e" />)}
        <path d="M520 240h40v28h-40z" fill="#ff7058" />
      </g>
    )}

    {art === 'plane' && (
      <g>
        <rect y="318" width="600" height="82" fill="#1B4180" />
        <g fill="#f4efe6" opacity=".55">{[40, 140, 240, 340, 440, 540].map((x) => <rect x={x} y="356" width="50" height="4" />)}</g>
        <g transform="translate(300 190) rotate(-12)">
          <path d="M-220 0c0-16 14-26 40-26h300c40 0 80 10 100 26-20 16-60 26-100 26h-300c-26 0-40-10-40-26z" fill="#f4efe6" />
          <path d="M-40 -6 60 -110h30L40 -6z" fill="#e3ddd2" />
          <path d="M-40 6 60 110h30L40 6z" fill="#d9d2c6" />
          <path d="M-200 -14-230 -70h22l38 50z" fill="#ff7058" />
          <rect x="160" y="-10" width="38" height="8" rx="3" fill="#3A69B0" />
          <path d="M-150 -2h260" stroke="#B9CBEA" stroke-width="3" />
        </g>
      </g>
    )}

    {art === 'truck' && (
      <g>
        <rect y="300" width="600" height="100" fill="#1B4180" />
        <g fill="#f4efe6" opacity=".5">{[20, 120, 220, 320, 420, 520].map((x) => <rect x={x} y="352" width="60" height="5" />)}</g>
        <rect x="70" y="186" width="320" height="96" fill="#ff7058" />
        {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => <rect x={84 + i * 38} y="196" width="6" height="76" fill="#e85d46" />)}
        <rect x="60" y="282" width="420" height="14" fill="#062f2e" />
        <path d="M400 210h70l40 40v46H400z" fill="#062f2e" />
        <path d="M418 222h46l26 28h-72z" fill="#B9CBEA" />
        {[110, 160, 330, 380, 460].map((x) => <g><circle cx={x} cy="300" r="20" fill="#0F2550" /><circle cx={x} cy="300" r="7" fill="#B9CBEA" /></g>)}
      </g>
    )}

    {art === 'event' && (
      <g>
        <g fill="#f4efe6" opacity=".18"><path d="M90 0h40l70 300h-180z" /><path d="M470 0h40l70 300H400z" /></g>
        <rect y="292" width="600" height="108" fill="#062f2e" />
        <rect x="70" y="286" width="460" height="14" fill="#2B5CA3" />
        <rect x="70" y="286" width="460" height="3" fill="#ff7058" />
        <g transform="translate(150 196)">
          <path d="M10 84c-6 0-10-4-10-10v-8c0-8 6-12 14-14l60-14c20-22 50-34 90-34h60c34 0 60 12 84 32l40 8c16 4 24 12 24 26v4c0 6-4 10-10 10z" fill="#ff7058" />
          <path d="M96 38c18-16 40-24 70-24h40c22 0 40 8 56 24z" fill="#062f2e" opacity=".85" />
          <circle cx="80" cy="84" r="22" fill="#0F2550" /><circle cx="80" cy="84" r="9" fill="#B9CBEA" />
          <circle cx="250" cy="84" r="22" fill="#0F2550" /><circle cx="250" cy="84" r="9" fill="#B9CBEA" />
        </g>
        {[60, 160, 440, 540].map((x) => <rect x={x - 3} y="40" width="6" height="246" fill="#1B4180" />)}
        <rect x="57" y="40" width="486" height="8" fill="#1B4180" />
      </g>
    )}

    {art === 'marine' && (
      <g>
        <rect y="262" width="600" height="138" fill={`url(#${id}-sea)`} />
        <path d="M60 226h300l-20 48H82z" fill="#062f2e" />
        <rect x="90" y="190" width="70" height="36" fill="#1B4180" /><rect x="96" y="198" width="58" height="6" fill="#ffd2c2" />
        <path d="M200 226V150M200 160l60 66" stroke="#1B4180" stroke-width="5" />
        <rect x="250" y="200" width="40" height="26" fill="#ff7058" /><rect x="210" y="208" width="34" height="18" fill="#B9CBEA" />
        <path d="M360 300h150l-14 26H376z" fill="#ff7058" />
        <path d="M392 300v-26h52v26" fill="#f4efe6" /><rect x="402" y="280" width="32" height="6" fill="#3A69B0" />
        <path d="M444 284h40" stroke="#062f2e" stroke-width="4" />
        <path d="M376 300c-30 0-60 2-90 10" stroke="#f4efe6" stroke-width="2" stroke-dasharray="6 6" opacity=".7" />
        <g fill="#B9CBEA" opacity=".5"><rect x="80" y="290" width="70" height="3" /><rect x="190" y="312" width="50" height="3" /><rect x="520" y="340" width="40" height="3" /></g>
      </g>
    )}
  </svg>
  {photo && <img src={photo} alt={alt} loading="lazy" decoding="async" onerror="this.remove()" />}
</div>
<style>
  .service-art { position: relative; overflow: hidden; background: #245091; }
  .service-art svg, .service-art img { position: absolute; inset: 0; width: 100%; height: 100%; display: block; object-fit: cover; }
</style>
