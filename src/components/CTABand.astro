---
import { site } from '../config/site';
import { type Lang, href, u } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang; title?: string; text?: string; quotePath?: string }
const { lang, title, text, quotePath = '/e-services/quote' } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band reveal">
      <div>
        <h2>{title ?? u('readyTitle', lang)}</h2>
        <p>{text ?? u('readyText', lang)}</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={href(lang, quotePath)}>{u('quote', lang)}</a>
        <a class="btn btn-ghost-light" href={`https://wa.me/${site.contact.whatsapp}`} target="_blank" rel="noopener"><Icon name="whatsapp" /> {u('whatsapp', lang)}</a>
      </div>
    </div>
  </div>
</section>
