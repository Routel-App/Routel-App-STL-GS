---
import { site } from '../config/site';
import { type Lang, href, u } from '../i18n/ui';
import Icon from './Icon.astro';
interface Props { lang: Lang; title?: string; text?: string; quotePath?: string }
const { lang, title, text, quotePath = '/e-services/quote' } = Astro.props;
---
<section class="section">
  <div class="container">
    <div class="cta-band ribbed framed reveal"><i class="cast"></i><i class="cast"></i><i class="cast"></i><i class="cast"></i>
      <div>
        <h2>{title ?? u('readyTitle', lang)}</h2>
        <p>{text ?? u('readyText', lang)}</p>
      </div>
      <div class="actions">
        <a class="btn btn-primary" href={href(lang, quotePath)}>{u('quote', lang)}</a>
        <a class="btn btn-ghost-light" href={href(lang, '/contact')}>{u('contact', lang)}</a>
      </div>
    </div>
  </div>
</section>
