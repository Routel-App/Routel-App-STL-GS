---
import { site } from '../config/site';
import { type Lang, href, u } from '../i18n/ui';
import ServiceArt from './ServiceArt.astro';
interface Props {
  lang: Lang;
  title: string;
  lead?: string;
  eyebrow?: string;
  crumbs?: { label: string; path?: string }[];
  /** business-unit illustration shown instead of the default photo */
  art?: 'ship' | 'crane' | 'plane' | 'truck' | 'event' | 'marine';
  /** page-specific photo (overrides the illustration) */
  photo?: string;
}
const { lang, title, lead, eyebrow, crumbs = [], art, photo } = Astro.props;
---
<section class="page-hero">
  <div class="ph-art" aria-hidden="true">
    {art
      ? <div class="ph-img ph-svg"><ServiceArt art={art} photo={photo} /></div>
      : <div class="ph-img" style={`--photo: url('${photo ?? site.images.hero}')`}></div>}
    <span class="ph-slash"></span>
    <span class="ph-slash thin"></span>
  </div>
  <div class="container">
    <nav aria-label="breadcrumb">
      <ol class="crumbs">
        <li><a href={href(lang, '/')}>{u('breadcrumbHome', lang)}</a></li>
        {crumbs.map((c) => <li>{c.path ? <a href={href(lang, c.path)}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>)}
      </ol>
    </nav>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lead && <p class="lead">{lead}</p>}
    <div class="actions"><slot /></div>
  </div>
</section>
<style>
  .ph-art { position: absolute; top: var(--header-h); bottom: 0; inset-inline-end: 0; width: 34%; pointer-events: none; }
  .ph-img {
    position: absolute; inset: 0;
    background: linear-gradient(0deg, rgba(7, 59, 58, .3), rgba(7, 59, 58, .3)), var(--photo) center / cover, url('/images/page-hero.jpg') center / cover;
    filter: saturate(.9) contrast(1.03);
    clip-path: polygon(28% 0, 100% 0, 100% 100%, 0 100%);
  }
  .ph-svg { background: none; filter: none; }
  .ph-svg :global(.service-art) { position: absolute; inset: 0; }
  :global(html[dir='rtl']) .ph-img { clip-path: polygon(0 0, 72% 0, 100% 100%, 0 100%); }
  .ph-slash { position: absolute; bottom: 0; height: 46%; width: 34px; background: var(--coral); inset-inline-start: 12%; transform: skewX(-22deg); }
  .ph-slash.thin { width: 10px; inset-inline-start: calc(12% + 52px); background: var(--petrol); height: 30%; }
  .page-hero :global(.container) { padding-inline-end: 0; }
  .page-hero h1, .page-hero .lead { max-width: min(860px, 62%); }
  @media (max-width: 1000px) {
    .ph-art { width: 100%; height: 10px; inset-block: auto 0; }
    .ph-img { display: none; }
    .ph-slash { height: 10px; width: 100%; inset-inline-start: 0; transform: none !important; }
    .ph-slash.thin { display: none; }
    .page-hero h1, .page-hero .lead { max-width: none; }
  }
</style>
